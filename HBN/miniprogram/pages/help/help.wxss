/* pages/help/help.wxss */

/* 整体容器 */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
  position: relative;
}

/* 搜索区域 */
.search-section {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 30rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-box {
  flex: 1;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-right: 20rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.clear-inner {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.clear-inner::before,
.clear-inner::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 2rpx;
  background-color: #999;
  top: 50%;
  left: 0;
}

.clear-inner::before {
  transform: rotate(45deg);
}

.clear-inner::after {
  transform: rotate(-45deg);
}

.search-btn {
  width: 120rpx;
  height: 80rpx;
  background-color: #618a49;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
}

/* 搜索结果 */
.search-results {
  padding: 30rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.result-count {
  font-size: 24rpx;
  color: #999;
}

.result-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.result-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item-category {
  font-size: 24rpx;
  color: #618a49;
  margin-bottom: 10rpx;
}

.result-item-title {
  font-size: 28rpx;
  color: #333;
}

.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.no-result-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.no-result-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.contact-service {
  color: #618a49;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border: 1rpx solid #618a49;
  border-radius: 30rpx;
}

/* 帮助中心主内容 */
.help-content {
  padding-bottom: 30rpx;
}

/* 分类导航 */
.category-nav {
  background-color: #ffffff;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  margin-right: 40rpx;
  text-align: center;
  position: relative;
  padding-bottom: 10rpx;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #618a49;
  border-radius: 2rpx;
}

.category-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.category-item.active .category-name {
  color: #618a49;
  font-weight: bold;
}

/* 问题列表 */
.question-list {
  padding: 0 30rpx;
}

.question-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: #618a49;
  border-radius: 3rpx;
}

.question-items {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.question-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.question-item:last-child {
  border-bottom: none;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  position: relative;
}

.question-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding-right: 50rpx;
}

.question-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid #999;
  border-right: 2rpx solid #999;
  transform: rotate(135deg);
  transition: transform 0.3s;
  position: absolute;
  right: 30rpx;
  top: 40rpx;
}

.question-arrow.expanded {
  transform: rotate(-45deg);
}

.question-answer {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s;
  opacity: 0;
  background-color: #f9f9f9;
}

.question-answer.show {
  padding: 20rpx 30rpx;
  max-height: 1000rpx;
  opacity: 1;
}

/* 联系客服区域 */
.contact-section {
  position: relative;
  padding: 60rpx 30rpx;
  margin-top: 30rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.divider-line {
  width: 80rpx;
  height: 1rpx;
  background-color: #ddd;
}

.divider-text {
  margin: 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

.contact-button {
  width: 400rpx;
  height: 90rpx;
  background-color: #ffffff;
  border: 1rpx solid #618a49;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.contact-text {
  font-size: 28rpx;
  color: #618a49;
} 