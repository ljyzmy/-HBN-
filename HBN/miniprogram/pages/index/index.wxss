/* 重置容器样式，防止与app.wxss冲突 */
.page-container {
  height: 100vh;
  padding: 0;
  display: block;
  justify-content: initial;
  align-items: initial;
}

/* 容器样式 */
.container {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background-color: var(--birch-white);
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx 30rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: background-color 0.3s ease-in-out;
}

.nav-transparent {
  background-color: rgba(255, 255, 255, 0);
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(255, 0, 0, 0.1);
}

.search-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 130rpx;
  width: 240rpx;
}

.nav-placeholder {
  width: 80rpx;
}

/* 主轮播图样式 */
.main-swiper {
  width: 100%;
  height: 100vh;
}

/* 横向轮播图部分 */
.banner-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 400rpx;
}

/* 确保轮播图全屏并位于导航栏下方 */
.banner-swiper.fullscreen {
  height: 100vh;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.banner-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 下滑提示 */
.scroll-tip {
  position: absolute;
  bottom: 90rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  font-size: 24rpx;
  z-index: 100;
}

.arrow-down {
  width: 40rpx;
  height: 40rpx;
  margin-top: 10rpx;
  animation: bounce 1.5s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10rpx);
  }
}

/* 添加滚动容器包装器 */
.scroll-container-wrapper {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* 背景视频样式 */
.background-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  object-fit: cover;
  z-index: 0;
}

/* 视频覆盖层样式 - 半透明效果确保内容可读 */
.background-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, 
    rgba(249, 249, 247, 0.7), 
    rgba(249, 249, 247, 0.6),
    rgba(248, 245, 240, 0.7));
  z-index: 1;
}

/* 修改滚动容器样式 */
.scroll-container {
  position: relative;
  height: 100%;
  z-index: 2;
  padding-top: 170rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  will-change: transform;
  -webkit-overflow-scrolling: touch;
}

/* 滚动内容样式 */
.scroll-content {
  position: relative;
  z-index: 2;
}

/* 品牌故事区域 - 修改为半透明效果 */
.brand-story {
  margin: 30rpx;
  padding: 40rpx 30rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03);
  text-align: center;
  border-left: 8rpx solid rgba(166, 64, 54, 0.7);
  position: relative;
  overflow: hidden;
}

/* 取消之前的背景纹理 */
.brand-story::before {
  display: none;
}

/* 加强文本可读性 */
.brand-slogan {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--cedar-dark); /* 保持文字颜色不变 */
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.6); /* 添加文字阴影增强可读性 */
}

.brand-description {
  font-size: 30rpx;
  color: #333; /* 加深文字颜色，提高对比度 */
  margin-bottom: 30rpx;
  line-height: 1.5;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.5); /* 添加文字阴影 */
}

/* 调整徽章样式，确保在半透明背景下仍然可见 */
.brand-badges {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  position: relative; /* 确保在正确的层级 */
  z-index: 1;
}

.brand-badges::before {
  content: '';
  display: block;
  width: 100%;
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(97, 138, 73, 0.6), transparent); /* 调整分隔线透明度 */
  margin: 20rpx 0;
  opacity: 0.6;
}

.badge-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #618a49;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.7); /* 添加文字阴影 */
}

.badge-text {
  font-size: 24rpx;
  color: #666;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.6); /* 添加文字阴影 */
}

/* 限时专享区域 - 半透明背景效果 */
.flash-sale {
  margin: 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  border-right: 8rpx solid rgba(97, 138, 73, 0.7);
  position: relative;
  overflow: hidden;
}

/* 移除原有背景图片的设置 */
.flash-sale::before {
  display: none;
}

/* 保留轻微纹理装饰增强敦煌风格 */
.flash-sale::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('https://img.api.aa1.cn/2025/05/09/ff06cf8e6c851.png');
  background-size: 200rpx;
  opacity: 0.04;
  z-index: 0;
  pointer-events: none;
}

/* 将内容提升到覆盖层上方 */
.flash-content {
  position: relative;
  z-index: 1;
}

/* 确保原有样式保持不变 */
.flash-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.flash-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
}

.flash-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  background-color: var(--cedar-dark);
  margin-right: 16rpx;
  border-radius: 4rpx;
}

.flash-countdown {
  display: flex;
  align-items: center;
}

.countdown-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.countdown-box {
  display: inline-block;
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  background-color: #618a49;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.countdown-colon {
  margin: 0 5rpx;
  color: #618a49;
  font-weight: bold;
}

/* 限时专享滚动容器 */
.flash-scroll-container {
  position: relative;
  margin: 20rpx 0;
}

/* 滚动按钮样式 */
.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.scroll-btn:active {
  transform: translateY(-50%) scale(0.95);
  background-color: rgba(255, 255, 255, 0.9);
}

.left-btn {
  left: 10rpx;
}

.right-btn {
  right: 10rpx;
}

/* 箭头样式 */
.arrow-left, .arrow-right {
  width: 20rpx;
  height: 20rpx;
  border-style: solid;
  border-color: #618a49;
  border-width: 0;
}

.arrow-left {
  border-top-width: 3rpx;
  border-left-width: 3rpx;
  transform: rotate(-45deg);
  margin-left: 5rpx;
}

.arrow-right {
  border-top-width: 3rpx;
  border-right-width: 3rpx;
  transform: rotate(45deg);
  margin-right: 5rpx;
}

/* 横向滚动样式优化 */
.flash-products {
  display: flex;
  white-space: nowrap;
  padding: 10rpx 0;
  margin: 60 60rpx; /* 为两侧按钮留出空间 */
  overflow: hidden;
}

/* 确保产品卡片之间有适当间距 */
.flash-product {
  display: inline-block;
  width: 220rpx;
  margin: 0 10rpx;
  flex-shrink: 0;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.3s ease;
}

.flash-product:active {
  transform: scale(0.98);
}

.flash-product-image {
  width: 100%;
  height: 220rpx;
  object-fit: cover;
}

.flash-product-discount {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background-color: rgba(97, 138, 73, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
}

.flash-product-info {
  padding: 10rpx;
}

.flash-product-title {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.flash-product-price-row {
  display: flex;
  align-items: baseline;
}

.flash-product-price {
  font-size: 28rpx;
  color: #618a49;
  font-weight: bold;
  margin-right: 8rpx;
}

.flash-product-original {
  font-size: 20rpx;
  color: #999;
  text-decoration: line-through;
}

/* 明星产品系列 - 半透明背景效果 */
.product-series {
  margin: 30rpx;
  padding: 40rpx 30rpx 30rpx 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

/* 移除原有背景 */
.product-series::before {
  display: none;
}

/* 保留顶部装饰边框 */
.product-series::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(to right, rgba(166, 64, 54, 0.8), rgba(207, 152, 92, 0.8));
  border-radius: 20rpx 20rpx 0 0;
}

/* 确保内容在背景之上 */
.product-series .section-header,
.product-series .series-container {
  position: relative;
  z-index: 1;
}

.series-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.series-card {
  position: relative;
  height: 250rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.series-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.series-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: #fff;
  z-index: 2;
}

.series-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
}

.series-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 产品系列视频容器 */
.series-video-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 产品系列视频样式 */
.series-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 20rpx;
}

/* 视频加载动画 */
@keyframes seriesVideoFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.series-video {
  animation: seriesVideoFadeIn 0.5s ease forwards;
}

/* 通用区块样式 - 更新为更高级的设计 */
.section {
  margin: 30rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
}

.section-header.elegant::after {
  content: "";
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 40rpx;
  height: 3rpx;
  background-color: #618a49;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--dunhuang-brown);
  letter-spacing: 1rpx;
  font-family: "FZLiBian", "FZLTXH--GBK1-0", "方正兰亭黑", sans-serif;
  font-weight: 500;
}

.title-text::after {
  background-color: var(--dunhuang-red);
}

.more {
  font-size: 24rpx;
  color: #618a49;
  display: flex;
  align-items: center;
}

.more::after {
  content: "";
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid #618a49;
  border-right: 2rpx solid #618a49;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* 会员福利模块样式 - 更新 */
.benefit-list {
  display: flex;
  flex-direction: column;
}

.benefit-item {
  display: flex;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
  transition: all 0.3s ease;
}

.benefit-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.benefit-item:active {
  transform: scale(0.98);
}

.benefit-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  object-fit: cover;
}

.benefit-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 10rpx 0;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.benefit-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.benefit-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.benefit-tag {
  display: inline-block;
  background-color: rgba(97, 138, 73, 0.1);
  color: #618a49;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

.benefit-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #ccc;
  border-right: 2rpx solid #ccc;
  transform: rotate(45deg);
  margin-right: 10rpx;
}

/* 美妆攻略模块样式 - 更新 */
.strategy-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.strategy-item {
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.strategy-item:active {
  transform: translateY(4rpx);
}

.strategy-image {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx 16rpx 0 0;
  object-fit: cover;
}

.strategy-info {
  padding: 16rpx;
}

.strategy-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  height: 72rpx;
}

.strategy-read {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.strategy-read::before {
  content: "";
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23999"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>');
  background-size: contain;
  background-repeat: no-repeat;
  margin-right: 6rpx;
}

/* 热售商品模块样式 - 更新 */
.product-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-item {
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  position: relative;
}

.product-item:active {
  transform: scale(0.98);
}

.product-image {
  width: 100%;
  height: 450rpx;
  object-fit: cover;
}

.product-content {
  padding: 16rpx;
}

.product-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  height: 72rpx;
  line-height: 1.4;
}

.product-price-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 32rpx;
  color: #618a49;
  font-weight: bold;
  margin-right: 10rpx;
}

.product-original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.product-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #618a49;
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx 0 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.4);
}

/* 品牌理念模块 - 新增 */
.brand-philosophy {
  margin: 30rpx;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background-image: url('https://img.api.aa1.cn/2025/05/09/24817c7281585.png');
  background-size: cover;
  background-position: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.philosophy-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(138, 99, 77, 0.7);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  color: #ffffff;
}

.philosophy-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
