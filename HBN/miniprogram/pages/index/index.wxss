  margin: 0 10rpx;
  position: relative;
  overflow: hidden;
  transform: translateY(0);
  transition: all 0.3s;
}

.recommend-btn::after {
  border: none;
}

.recommend-btn:active {
  transform: translateY(2rpx);
}

.recommend-btn.close {
  background-color: #f5f5f5;
  color: #666;
}

.recommend-btn.check {
  background: linear-gradient(135deg, #A64036, #CF985C);
  color: #fff;
  box-shadow: 0 6rpx 15rpx rgba(166, 64, 54, 0.3);
}

.recommend-btn.check::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
  transform: scale(0);
  opacity: 0;
  transition: transform 0.5s, opacity 0.5s;
}

.recommend-btn.check:active::before {
  transform: scale(1);
  opacity: 1;
  transition: 0s;
}

/* 产品视频样式 */
.product-video {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
  background-color: rgba(0, 0, 0, 0.05);
}