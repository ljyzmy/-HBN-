/* pages/settings/settings.wxss */
page {
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
}

.container {
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

/* 顶部用户信息样式 */
.header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
  border: 1px solid #eee;
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}

.tap-hint {
  font-size: 24rpx;
  color: #999;
}

.arrow image {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

/* 设置列表样式 */
.settings-list {
  width: 100%;
}

.settings-group {
  margin-bottom: 20rpx;
}

.group-title {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
}

.group-content {
  background-color: #fff;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.item-name {
  font-size: 30rpx;
  color: #333;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-value {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

.arrow-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.5;
}

/* 防止开关点击事件冒泡 */
.__preventTap {
  pointer-events: none;
}

/* 退出登录按钮样式 */
.logout-button {
  margin: 40rpx 30rpx;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background-color: #fff;
  color: #ff5a5f;
  font-size: 32rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.logout-button:active {
  opacity: 0.8;
}

/* 底部版权信息 */
.footer {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 30rpx 0;
}
