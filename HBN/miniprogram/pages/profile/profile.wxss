/* pages/profile/profile.wxss */
page {
  background-color: #f8f8f8;
}

.container {
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

/* 顶部头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background-color: #fff;
  margin-bottom: 20rpx;
  position: relative;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.edit-icon {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(97, 138, 73, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon image {
  width: 30rpx;
  height: 30rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 会员等级标签 */
.member-badge {
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #e6c678, #d1a658);
  color: #6d4d28;
  font-size: 24rpx;
  border-radius: 30rpx;
  font-weight: bold;
}

/* 用户画像选择器 */
.profile-selector {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 30rpx;
  background-color: #f9f9f9;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #eee;
}

.profile-selector:active {
  background-color: #f0f0f0;
}

.dropdown-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 10rpx;
}

/* 用户画像类型列表 */
.profile-types {
  display: flex;
  justify-content: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.profile-type {
  padding: 14rpx 30rpx;
  font-size: 28rpx;
  color: #999;
  margin: 0 10rpx;
  border-radius: 40rpx;
  background-color: #f9f9f9;
  transition: all 0.3s;
}

.profile-type.active {
  color: #fff;
  background: linear-gradient(135deg, #618a49, #8aad75);
  box-shadow: 0 4rpx 8rpx rgba(97, 138, 73, 0.2);
}

.profile-type:active {
  transform: scale(0.95);
}

/* 信息编辑区域 */
.profile-info {
  background-color: #fff;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

/* 信息分节标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0 10rpx 30rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 30rpx;
  width: 8rpx;
  background-color: #618a49;
  border-radius: 4rpx;
}

.sub-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #444;
  margin: 20rpx 0 10rpx 0;
}

.info-section {
  width: 100%;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.item-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
}

.item-value {
  flex: 1;
  font-size: 30rpx;
  color: #666;
}

.item-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.5;
}

/* 列表样式 */
.info-list {
  display: flex;
  flex-direction: column;
}

.list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.bullet {
  margin-right: 16rpx;
  color: #618a49;
  font-size: 32rpx;
}

.list-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.info-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 标签样式 */
.tags-container {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #f5f5f5;
  color: #618a49;
  font-size: 24rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

/* 购买历史样式 */
.purchase-history {
  display: flex;
  flex-direction: column;
}

.purchase-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.purchase-item:last-child {
  border-bottom: none;
}

.purchase-date {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.purchase-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.purchase-product {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.purchase-price {
  font-size: 28rpx;
  color: #ff6b6b;
  font-weight: 500;
}

/* 底部按钮组 */
.button-group {
  display: flex;
  padding: 30rpx;
}

.edit-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #618a49;
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
  font-weight: 500;
}

.cancel-button, .save-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 40rpx;
  font-weight: 500;
}

.cancel-button {
  background-color: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}

.save-button {
  background-color: #618a49;
  color: #fff;
}

/* 选择器样式 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
}

.picker, .date-picker, .region-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  background-color: #fff;
  z-index: 999;
  animation: slideUp 0.3s ease-in-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel, .picker-confirm {
  font-size: 30rpx;
  color: #618a49;
}

.picker-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.picker-item {
  line-height: 50px;
  text-align: center;
  font-size: 32rpx;
  color: #333;
}

/* 未登录提示 */
.login-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx;
  background-color: #fff;
}

.tip-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.login-button {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #618a49;
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
  font-weight: 500;
}

/* 用户画像选择器弹窗 */
.profile-picker-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  z-index: 999;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  animation: slideUp 0.3s ease-in-out;
  overflow: hidden;
}

.profile-options {
  max-height: 70vh;
  overflow-y: auto;
  padding: 20rpx 0;
}

.profile-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.profile-option:last-child {
  border-bottom: none;
}

.profile-option.selected {
  background-color: rgba(97, 138, 73, 0.05);
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 1rpx solid #eee;
}

.profile-option-content {
  flex: 1;
}

.profile-option-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.profile-option-desc {
  font-size: 24rpx;
  color: #999;
}

.profile-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #618a49;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
} 