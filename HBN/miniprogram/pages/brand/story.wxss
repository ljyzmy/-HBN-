.brand-story-container { display: flex; flex-direction: column; min-height: 100vh; background-color: #fff; padding: 20rpx; }

/* pages/brand/story.wxss */
.brand-container {
  background-color: #fcfcfc;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 轮播图样式 */
.brand-banner {
  position: relative;
  height: 500rpx;
  overflow: hidden;
}

.brand-banner swiper {
  height: 100%;
  width: 100%;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.banner-title {
  position: absolute;
  bottom: 60rpx;
  left: 40rpx;
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
  letter-spacing: 2rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.banner-indicator {
  position: absolute;
  bottom: 30rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
}

.indicator-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.6);
  margin: 0 8rpx;
}

.indicator-dot.active {
  width: 22rpx;
  height: 22rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 通用section样式 */
.section {
  margin: 60rpx 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  position: relative;
}

.section-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
  position: relative;
  padding-left: 24rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(to bottom, var(--dunhuang-red), var(--dunhuang-orange));
  border-radius: 4rpx;
}

/* 品牌介绍部分 */
.intro-content {
  text-align: center;
  padding: 20rpx;
}

.intro-logo {
  font-size: 64rpx;
  font-weight: bold;
  color: var(--cedar-dark);
  margin-bottom: 20rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  letter-spacing: 4rpx;
}

.intro-slogan {
  font-size: 40rpx;
  color: var(--cedar-medium);
  margin-bottom: 30rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  letter-spacing: 2rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
  text-indent: 2em;
  letter-spacing: 1rpx;
}

/* 创始人部分 */
.founder-content {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.founder-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  margin-right: 40rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.founder-name {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 10rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.founder-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.founder-quote {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
  font-style: italic;
  position: relative;
  padding-left: 20rpx;
  border-left: 4rpx solid var(--cedar-light);
}

/* 价值观部分 */
.values-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.value-item {
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s;
}

.value-item:active {
  transform: scale(0.98);
  background-color: #f5f5f5;
}

.value-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.value-title {
  font-size: 32rpx;
  color: var(--cedar-dark);
  font-weight: 600;
  margin-bottom: 15rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.value-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 时间线部分 */
.timeline {
  padding: 20rpx 0;
  max-height: 900rpx;
  overflow-y: auto;
}

.timeline-item {
  display: flex;
  margin-bottom: 30rpx;
  position: relative;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-year {
  width: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--cedar-medium);
  flex-shrink: 0;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

.timeline-connector {
  width: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex-shrink: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: var(--cedar-medium);
  margin-top: 10rpx;
}

.timeline-line {
  position: absolute;
  top: 30rpx;
  width: 2rpx;
  height: calc(100% + 20rpx);
  background-color: rgba(97, 138, 73, 0.2);
}

.timeline-content {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  padding-top: 6rpx;
  padding-right: 10rpx;
}

/* 滚动条美化 */
.timeline::-webkit-scrollbar {
  width: 4rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.timeline::-webkit-scrollbar-thumb {
  background-color: rgba(97, 138, 73, 0.3);
  border-radius: 4rpx;
}

/* 奖项部分 */
.awards-list {
  display: flex;
  flex-direction: column;
}

.award-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.award-item:last-child {
  border-bottom: none;
}

.award-logo {
  width: 100rpx;
  height: 100rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.award-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.award-year {
  font-size: 26rpx;
  color: #999;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

/* 承诺部分 */
.promise-content {
  display: flex;
  flex-direction: column;
}

.promise-item {
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 20rpx;
}

.promise-item:last-child {
  margin-bottom: 0;
}

.promise-title {
  font-size: 32rpx;
  color: var(--cedar-medium);
  font-weight: 600;
  margin-bottom: 15rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.promise-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 底部品牌标识 */
.brand-footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
  margin-top: 60rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.footer-logo {
  font-size: 50rpx;
  font-weight: bold;
  color: var(--cedar-dark);
  margin-bottom: 15rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  letter-spacing: 3rpx;
}

.footer-slogan {
  font-size: 28rpx;
  color: var(--cedar-medium);
  margin-bottom: 20rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  letter-spacing: 1rpx;
}

.footer-copyright {
  font-size: 24rpx;
  color: #999;
}

.timeline-footer {
  text-align: center;
  margin-top: 15rpx;
  padding: 10rpx 0;
  position: relative;
}

.timeline-more {
  font-size: 24rpx;
  color: #999;
  position: relative;
  display: inline-block;
  padding: 0 30rpx;
}

.timeline-more::before,
.timeline-more::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 20rpx;
  height: 2rpx;
  background-color: rgba(97, 138, 73, 0.3);
}

.timeline-more::before {
  left: 0;
}

.timeline-more::after {
  right: 0;
}
