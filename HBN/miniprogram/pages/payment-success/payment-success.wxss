.success-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: transparent;
  position: relative;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}

/* 视频背景 */
.bg-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  object-fit: cover;
}

/* 背景覆盖层 */
.bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0, 0, 20, 0.7), rgba(10, 30, 10, 0.6));
  z-index: -1;
}

/* 内容容器 */
.content-container {
  width: 100%;
  padding: 180rpx 30rpx 50rpx;
  box-sizing: border-box;
  z-index: 5;
}

/* 支付成功信息框 */
.success-info-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

/* 成功标题 */
.success-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

/* 成功消息 */
.success-message {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 40rpx;
}

/* 订单金额 */
.order-amount {
  font-size: 80rpx;
  color: #8eb98c;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.4);
  font-weight: bold;
  margin: 20rpx 0 40rpx;
  letter-spacing: 2rpx;
}

.order-amount text {
  font-size: 50rpx;
  margin-right: 4rpx;
}

/* 订单信息卡片 */
.order-info-card {
  width: 90%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.info-item {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 180rpx;
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.7);
}

.info-value {
  flex: 1;
  color: rgba(255, 255, 255, 0.9);
}

/* 地址信息和配送信息 */
.address-info, .delivery-info {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.3);
}

.address-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 16rpx;
}

.address-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 20rpx;
  background: linear-gradient(to bottom, #b1d8af, #8eb98c);
  border-radius: 3rpx;
}

.address-row {
  display: flex;
  align-items: flex-start;
}

.address-row .info-value {
  word-break: break-all;
  line-height: 1.4;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin: 30rpx 0;
  padding: 0 20rpx;
}

.btn {
  width: 45%;
  height: 88rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  box-shadow: 0 6rpx 15rpx rgba(0, 0, 0, 0.2);
  border: none;
}

.view-order {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.continue-shopping {
  background: linear-gradient(135deg, #8eb98c, #6b9c69);
  color: #fff;
}

/* 推荐商品部分 */
.recommend-section {
  margin-top: 40rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
}

.section-title text {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 10rpx;
}

.title-line {
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(to right, transparent, #ffcf87, transparent);
  margin-top: 10rpx;
}

.recommend-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.recommend-item {
  width: 48%;
  margin-bottom: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.recommend-item:active {
  transform: scale(0.97);
}

.recommend-image-container {
  position: relative;
  width: 100%;
  height: 200rpx;
}

.recommend-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.discount-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: #8eb98c;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx 0 20rpx 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.recommend-info {
  padding: 16rpx;
}

.recommend-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 10rpx;
  line-height: 1.4;
  height: 72rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price-info {
  display: flex;
  align-items: baseline;
}

.current-price {
  font-size: 32rpx;
  color: #8eb98c;
  font-weight: bold;
  margin-right: 10rpx;
}

.original-price {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-decoration: line-through;
}

/* 底部装饰 */
.bottom-decoration {
  width: 100%;
  height: 120rpx;
  margin-top: 30rpx;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="rgba(255,255,255,0.1)"></path></svg>');
  background-size: cover;
  background-position: center top;
  opacity: 0.6;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx 30rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: background-color 0.3s ease-in-out;
}

.nav-transparent {
  background-color: rgba(0, 0, 0, 0);
}

.nav-opaque {
  background: rgba(0, 10, 30, 0.8);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-top: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  transform: rotate(-45deg);
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 100rpx;
  width: 180rpx;
}

.nav-placeholder {
  width: 60rpx;
} 