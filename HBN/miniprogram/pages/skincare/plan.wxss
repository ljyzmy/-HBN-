/* pages/skincare/plan.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 40rpx;
}

/* 顶部用户信息区 */
.header-section {
  background: linear-gradient(135deg, #618a49, #8aad75);
  padding: 40rpx 30rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.user-profile {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.test-btn {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  width: fit-content;
  display: flex;
  align-items: center;
  backdrop-filter: blur(5px);
}

.test-btn text {
  color: #ffffff;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.test-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 通用部分标题 */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.title-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.title-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 34rpx;
  background-color: #618a49;
  border-radius: 4rpx;
}

/* 皮肤分析区域 */
.analysis-section {
  margin-bottom: 30rpx;
}

.analysis-card {
  margin: 0 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 30rpx;
}

.skin-type-row, .skin-concern-row, .recommendation-row {
  margin-bottom: 20rpx;
}

.skin-type-row {
  display: flex;
  align-items: center;
}

.label {
  color: #666;
  font-size: 28rpx;
  margin-right: 10rpx;
  white-space: nowrap;
}

.value {
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
}

.concern-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.concern-tag {
  background-color: rgba(97, 138, 73, 0.1);
  color: #618a49;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.recommendation-row {
  display: flex;
  flex-direction: column;
}

.recommendation-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

/* 护肤方案区域 */
.skincare-section {
  margin-bottom: 30rpx;
}

.add-all-btn {
  background-color: #618a49;
  color: white;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(97, 138, 73, 0.2);
}

.step-tabs {
  display: flex;
  justify-content: space-between;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 30rpx 20rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow-x: auto;
}

.step-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 10rpx;
  min-width: 100rpx;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.step-tab.active {
  background-color: rgba(97, 138, 73, 0.1);
}

.step-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
}

.step-name {
  font-size: 24rpx;
  color: #666;
}

.step-tab.active .step-name {
  color: #618a49;
  font-weight: bold;
}

/* 产品列表 */
.product-list {
  margin: 0 30rpx;
}

.product-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.product-price-row {
  display: flex;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  color: #618a49;
  font-weight: bold;
  margin-right: 15rpx;
}

.product-original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

/* 空状态提示 */
.empty-tip {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* 加载状态 */
.loading-box {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(97, 138, 73, 0.3);
  border-radius: 50%;
  border-top-color: #618a49;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 护肤小贴士 */
.tips-section {
  margin-bottom: 30rpx;
}

.tips-content {
  margin: 0 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 30rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 0;
}

.tip-number {
  width: 40rpx;
  height: 40rpx;
  background-color: #618a49;
  color: white;
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tip-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
  flex: 1;
}

/* 底部安全区域 */
.safe-bottom {
  height: 40rpx;
}

/* 添加产品标签样式 */
.product-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.product-tag {
  font-size: 20rpx;
  color: #618a49;
  background-color: rgba(97, 138, 73, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}