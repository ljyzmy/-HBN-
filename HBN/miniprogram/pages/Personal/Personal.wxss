/* 服务名称 */
.service-name {
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

/* 品牌故事高级优化 */
.brand-story-premium {
  margin: 0 30rpx 60rpx;
  height: 400rpx; /* 修复高度值 */
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
  transform: translateZ(0);
  border: 1rpx solid rgba(138, 99, 77, 0.15);
}

/* 品牌故事视频背景 */
.brand-bg-video {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.brand-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(138, 99, 77, 0.7), rgba(166, 64, 54, 0.6));
  z-index: 1;
  mix-blend-mode: overlay;
}

/* 品牌故事背景优化 */
.brand-parallax {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(138, 99, 77, 0.6), rgba(166, 64, 54, 0.5));
  z-index: 0;
  transition: transform 0.5s ease;
}

.brand-story-premium:active .brand-parallax {
  transform: scale(1.03);
}

/* 修改背景，使用视频背景替代原来的图片背景 */
.brand-parallax::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.2);
  z-index: 2;
}

/* 增加文本可见度 */
.brand-parallax::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(0,0,0,0.1), rgba(0,0,0,0.4));
  opacity: 0.7;
  z-index: 3;
}

/* 品牌内容层级提高 */
.brand-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.brand-logo-premium {
  font-size: 72rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
  font-family: 'Arial', sans-serif;
  letter-spacing: 2rpx;
  opacity: 0.95;
}

.brand-logo-premium::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.7), transparent);
}

.brand-slogan-premium {
  font-size: 42rpx;
  color: #ffffff;
  margin-bottom: 25rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  letter-spacing: 2rpx;
  opacity: 0.95;
  width: 100%;
  text-align: center;
}

.brand-desc-premium {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 35rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 1rpx;
  width: 100%;
  text-align: center;
  line-height: 1.6;
}

/* 按钮优化 */
.brand-button {
  padding: 18rpx 36rpx;
  background-color: rgba(255, 255, 255, 0.25);
  font-size: 28rpx;
  border-radius: 50rpx;
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
  letter-spacing: 2rpx;
  position: relative;
  overflow: hidden;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
}

.brand-button:active {
  transform: translateY(2rpx);
  background-color: rgba(255, 255, 255, 0.35);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 统一字重设置 */
.user-name, .card-title, .story-logo {
  font-weight: 500;
}

/* 高端卡片通用样式优化 */
.premium-card {
  margin: 0 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0;
  box-shadow: 0 10rpx 35rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  border: 1rpx solid rgba(97, 138, 73, 0.1);
  position: relative;
}

/* 高端卡片标题区域优化 */
.premium-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  position: relative;
  background: linear-gradient(to right, rgba(250, 250, 250, 0.5), rgba(255, 255, 255, 0.95));
}

.header-left {
  display: flex;
  align-items: center;
  position: relative;
}

.premium-title-icon {
  width: 8rpx;
  height: 34rpx;
  background: linear-gradient(to bottom, var(--dunhuang-red), var(--dunhuang-orange));
  border-radius: 4rpx;
  margin-right: 20rpx;
  position: relative;
}

.premium-title-icon::before {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  background: radial-gradient(circle, rgba(166, 64, 54, 0.15), transparent 70%);
  border-radius: 6rpx;
}

.premium-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  letter-spacing: 1rpx;
  position: relative;
}

.premium-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 0;
  height: 2rpx;
  background: linear-gradient(to right, var(--cedar-medium), transparent);
  opacity: 0;
  transition: width 0.3s ease, opacity 0.3s ease;
}

.premium-header:active .premium-title::after {
  width: 100%;
  opacity: 0.6;
}

.premium-more {
  display: flex;
  align-items: center;
  opacity: 0.9;
  transition: all 0.3s;
  padding: 8rpx 12rpx;
  border-radius: 30rpx;
}

.premium-more:active {
  opacity: 1;
  background-color: rgba(0,0,0,0.03);
}

.more-text {
  font-size: 26rpx;
  color: #999;
  margin-right: 10rpx;
  font-weight: 500;
}

.premium-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #999;
  border-right: 2rpx solid #999;
  transform: rotate(45deg);
  position: relative;
  transition: transform 0.3s ease;
}

.premium-more:active .premium-arrow {
  transform: rotate(45deg) translateX(4rpx);
}

/* 优雅分割线 */
.premium-divider {
  height: 1rpx;
  background: linear-gradient(to right, rgba(0,0,0,0.06), rgba(0,0,0,0.03), rgba(0,0,0,0.06));
  margin: 0;
  position: relative;
  overflow: hidden;
}

.premium-divider::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.6), transparent);
  animation: shine 3s infinite;
}

@keyframes shine {
  0% {
    left: -100%;
  }
  40%, 100% {
    left: 100%;
  }
}

/* 资产模块优化 */
.account-assets {
  position: relative;
  padding: 40rpx 20rpx;
  border-left: none;
  overflow: hidden;
  background-color: #ffffff;
  margin: 80rpx 30rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 35rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(97, 138, 73, 0.1);
}

.assets-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  z-index: 1;
}

.asset-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 10rpx;
  transition: all 0.3s;
}

.asset-column:active {
  transform: scale(0.95);
}

.asset-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--cedar-medium);
  margin-bottom: 10rpx;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

.asset-label {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 1rpx;
}

/* 修改服务样式为一行一个 */
.service-list {
  display: flex;
  flex-direction: column;
  position: relative;
}

.service-row-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--birch-light);
}

.service-row-item:last-child {
  border-bottom: none;
}

.service-row-left {
  display: flex;
  align-items: center;
}

.service-row-left .service-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
  margin-bottom: 0;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  opacity: 0.8;
}

.service-row-left .service-name {
  font-size: 28rpx;
  color: #333;
  text-align: left;
}

/* 添加用户画像弹窗样式 */
.avatar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-modal-content {
  position: relative;
  width: 88%;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  z-index: 1001;
  display: flex;
  flex-direction: column;
}

.avatar-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 10rpx;
}

.avatar-modal-desc {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 30rpx;
}

.avatar-list {
  max-height: calc(80vh - 240rpx);
  overflow-y: auto;
}

.avatar-item {
  margin-bottom: 30rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.avatar-item:active {
  transform: scale(0.98);
  background-color: rgba(97, 138, 73, 0.05);
}

.avatar-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-item-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar-item-info {
  flex: 1;
}

.avatar-item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.avatar-item-age {
  font-size: 24rpx;
  color: #999;
}

.avatar-item-detail {
  font-size: 26rpx;
  color: #666;
}

.avatar-item-row {
  margin-bottom: 10rpx;
  display: flex;
  align-items: flex-start;
}

.avatar-item-label {
  font-weight: bold;
  color: #618a49;
  margin-right: 10rpx;
  white-space: nowrap;
}

.avatar-item-value {
  flex: 1;
  line-height: 1.5;
}

.avatar-modal-btn {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 44rpx;
  color: #fff;
  background: linear-gradient(135deg, #618a49, #8aad75);
  box-shadow: 0 4rpx 12rpx rgba(97, 138, 73, 0.3);
  transition: all 0.3s;
}

.avatar-modal-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(97, 138, 73, 0.2);
}

.avatar-modal-btn.cancel {
  background: linear-gradient(135deg, #999, #bbb);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 登录模态框 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 40rpx;
}

.modal-btn.cancel {
  margin-right: 20rpx;
  border: 1rpx solid #ddd;
  color: #666;
}

.modal-btn.confirm {
  background-color: var(--dunhuang-red);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(166, 64, 54, 0.3);
}

/* 品牌故事背景动画 */
@keyframes subtle-move {
  0% {
    background-position: 0% 0%;
  }
  50% {
    background-position: 100% 100%;
  }
  100% {
    background-position: 0% 0%;
  }
}

/* 添加按钮光效 */
.brand-button::before {
  content: '';
  position: absolute;
  top: -100%;
  left: -100%;
  width: 50%;
  height: 300%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.3) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(25deg);
  animation: shine 6s infinite;
  animation-delay: 1s;
}

@keyframes shine {
  0% {
    left: -100%;
    opacity: 0.7;
  }
  20% {
    left: 100%;
    opacity: 0.7;
  }
  100% {
    left: 100%;
    opacity: 0;
  }
}

/* 品牌标志呼吸效果 */
.brand-logo-premium {
  animation: breathe 5s infinite ease-in-out;
}

@keyframes breathe {
  0%, 100% {
    opacity: 0.9;
    text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
  }
  50% {
    opacity: 1;
    text-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4), 0 0 30rpx rgba(255, 255, 255, 0.15);
  }
}