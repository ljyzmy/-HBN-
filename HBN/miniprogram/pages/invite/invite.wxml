<!-- pages/invite/invite.wxml -->
<view class="container">
  <!-- 顶部卡片 -->
  <view class="invite-card">
    <view class="card-bg">
      <view class="card-content">
        <view class="brand-logo">HBN</view>
        <view class="invite-title">{{inviteInfo.title}}</view>
        <view class="invite-desc">{{inviteInfo.desc}}</view>
        
        <view class="invite-code-box">
          <view class="code-label">我的邀请码</view>
          <view class="code-value">{{inviteInfo.code}}</view>
          <view class="copy-btn" bindtap="copyInviteCode">复制</view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 分享区域 -->
  <view class="share-section">
    <view class="section-title">
      <view class="title-line"></view>
      <text>分享给好友</text>
      <view class="title-line"></view>
    </view>
    
    <view class="share-methods">
      <button class="share-btn" open-type="share">
        <image class="share-icon" src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/微信.png" mode="aspectFit"></image>
        <text>分享给好友</text>
      </button>
      
      <view class="share-btn qrcode-btn-wrapper">
        <view class="qrcode-container" bindtap="saveQrCode">
          <image class="share-icon" src="{{inviteInfo.qrCodeUrl}}" mode="aspectFit" wx:if="{{!isGeneratingQrCode && inviteInfo.qrCodeUrl}}"></image>
          <view class="qrcode-loading" wx:if="{{isGeneratingQrCode}}">
            <view class="loading-spinner"></view>
          </view>
          <view class="qrcode-placeholder" wx:if="{{!isGeneratingQrCode && !inviteInfo.qrCodeUrl}}">
            <text class="placeholder-text">二维码生成失败</text>
          </view>
        </view>
        <text>保存二维码</text>
        <view class="refresh-btn" catchtap="regenerateQrCode" wx:if="{{!isGeneratingQrCode}}">
          <view class="refresh-icon"></view>
        </view>
      </view>
    </view>
    
    <view class="qrcode-tip">
      <text>二维码为示例图片，包含您的邀请码：{{inviteInfo.code}}</text>
    </view>
  </view>
  
  <!-- 奖励区域 -->
  <view class="rewards-section">
    <view class="section-title">
      <view class="title-line"></view>
      <text>邀请奖励</text>
      <view class="title-line"></view>
    </view>
    
    <view class="reward-cards">
      <view class="reward-card" wx:for="{{rewards}}" wx:key="id">
        <image class="reward-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="reward-info">
          <view class="reward-name">{{item.name}}</view>
          <view class="reward-value">{{item.reward}}</view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 统计信息 -->
  <view class="statistics-section">
    <view class="stat-item">
      <view class="stat-value">{{statistics.totalInvites}}</view>
      <view class="stat-label">已邀请好友</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value">{{statistics.totalPoints}}</view>
      <view class="stat-label">获得积分</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value">{{statistics.totalCoupons}}</view>
      <view class="stat-label">获得优惠券</view>
    </view>
  </view>
  
  <!-- 邀请记录 -->
  <view class="records-section">
    <view class="records-header">
      <view class="records-title">邀请记录</view>
      <view class="records-rules" bindtap="toggleRules">
        <text>活动规则</text>
        <view class="arrow-icon {{showRules ? 'up' : 'down'}}"></view>
      </view>
    </view>
    
    <!-- 活动规则 -->
    <view class="rules-content" wx:if="{{showRules}}">
      <view class="rule-item" wx:for="{{rules}}" wx:key="*this">{{item}}</view>
    </view>
    
    <!-- 邀请记录列表 -->
    <view class="no-records" wx:if="{{inviteRecords.length === 0}}">
      <image class="no-data-icon" src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/空状态.png" mode="aspectFit"></image>
      <text>暂无邀请记录</text>
    </view>
    
    <view class="record-list" wx:else>
      <view class="record-item" wx:for="{{inviteRecords}}" wx:key="id">
        <view class="record-user">
          <image class="record-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="record-name">{{item.name}}</view>
        </view>
        <view class="record-time">{{item.time}}</view>
        <view class="record-reward">+{{item.reward}}</view>
      </view>
    </view>
  </view>
</view>

<!-- 邀请提示 -->
<view class="invite-tip">
  <view class="tip-icon"></view>
  <text>邀请好友注册并购物，双方都可获得奖励哦~</text>
</view> 