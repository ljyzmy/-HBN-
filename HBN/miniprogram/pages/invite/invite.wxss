/* pages/invite/invite.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 120rpx;
  position: relative;
}

/* 顶部卡片 */
.invite-card {
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.card-bg {
  background: linear-gradient(135deg, #618a49, #8aad75);
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  padding: 40rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(97, 138, 73, 0.2);
}

.card-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('https://img.api.aa1.cn/2025/05/07/a80093e62c237.jpg');
  background-repeat: repeat;
  background-size: 200rpx auto;
  opacity: 0.1;
  mix-blend-mode: overlay;
}

.card-content {
  position: relative;
  z-index: 2;
  color: #ffffff;
  text-align: center;
}

.brand-logo {
  font-size: 60rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.invite-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.invite-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}

.invite-code-box {
  background-color: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.code-value {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

.copy-btn {
  background-color: rgba(255, 255, 255, 0.3);
  padding: 10rpx 40rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  transition: all 0.3s;
}

.copy-btn:active {
  background-color: rgba(255, 255, 255, 0.5);
  transform: scale(0.95);
}

/* 分享区域 */
.share-section {
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.title-line {
  width: 60rpx;
  height: 1rpx;
  background-color: #ddd;
}

.section-title text {
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.share-methods {
  display: flex;
  justify-content: space-around;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: transparent;
  padding: 0;
  margin: 0;
  line-height: normal;
  width: auto;
  border: none;
}

.share-btn::after {
  display: none;
}

.share-icon {
  width: 90rpx;
  height: 90rpx;
  margin-bottom: 15rpx;
  border-radius: 10rpx;
}

.share-btn text {
  font-size: 24rpx;
  color: #666;
}

/* 二维码按钮相关 */
.qrcode-btn-wrapper {
  position: relative;
}

.refresh-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: #618a49;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
  z-index: 3;
}

.refresh-icon {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid white;
  border-top-color: transparent;
  border-radius: 50%;
  position: relative;
}

.refresh-icon::before {
  content: '';
  position: absolute;
  top: -6rpx;
  right: -2rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 6rpx solid white;
  transform: rotate(45deg);
}

.qrcode-tip {
  text-align: center;
  padding: 20rpx 0 0;
  font-size: 20rpx;
  color: #999;
}

/* 奖励区域 */
.rewards-section {
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.reward-cards {
  display: flex;
  flex-direction: column;
}

.reward-card {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.reward-card:last-child {
  border-bottom: none;
}

.reward-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.reward-info {
  flex: 1;
}

.reward-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.reward-value {
  font-size: 24rpx;
  color: #618a49;
}

/* 统计信息 */
.statistics-section {
  display: flex;
  justify-content: space-between;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  color: #618a49;
  font-weight: bold;
  margin-bottom: 10rpx;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #f0f0f0;
  margin: 0 20rpx;
}

/* 邀请记录 */
.records-section {
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.records-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.records-rules {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.arrow-icon {
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid #999;
  border-right: 2rpx solid #999;
  margin-left: 10rpx;
}

.arrow-icon.down {
  transform: rotate(135deg);
}

.arrow-icon.up {
  transform: rotate(-45deg);
}

.rules-content {
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.rule-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.no-records {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.no-data-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.no-records text {
  font-size: 26rpx;
  color: #999;
}

.record-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-user {
  display: flex;
  align-items: center;
  flex: 1;
}

.record-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.record-name {
  font-size: 26rpx;
  color: #333;
  max-width: 150rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-time {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  text-align: center;
}

.record-reward {
  font-size: 26rpx;
  color: #618a49;
  font-weight: bold;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

/* 邀请提示 */
.invite-tip {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 30rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 10;
  max-width: 90%;
}

.tip-icon {
  width: 30rpx;
  height: 30rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ffffff"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>');
  background-size: contain;
  background-repeat: no-repeat;
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* 二维码容器样式 */
.qrcode-container {
  width: 90rpx;
  height: 90rpx;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  background-color: #f5f5f5;
  position: relative;
  border: 1rpx solid #eee;
}

/* 二维码加载动画 */
.qrcode-loading {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(97, 138, 73, 0.2);
  border-top-color: #618a49;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 二维码占位符 */
.qrcode-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
}

.placeholder-text {
  font-size: 18rpx;
  color: #999;
  text-align: center;
  padding: 4rpx;
} 