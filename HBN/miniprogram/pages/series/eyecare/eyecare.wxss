.eyecare-container {
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx 30rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: background-color 0.3s ease-in-out;
}

.nav-transparent {
  background-color: rgba(255, 255, 255, 0);
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(230, 163, 51, 0.1);
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 130rpx;
  width: 240rpx;
}

.nav-placeholder {
  width: 80rpx;
}

/* 背景视频样式 */
.background-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  object-fit: cover;
  z-index: 0;
}

/* 视频覆盖层样式 - 半透明效果确保内容可读 */
.background-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, 
    rgba(249, 249, 247, 0.7), 
    rgba(249, 249, 247, 0.6),
    rgba(248, 245, 240, 0.7));
  z-index: 1;
}

/* 内容滚动区域 */
.content-scroll {
  position: relative;
  height: 100vh;
  z-index: 2;
  padding-top: 170rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

/* 系列介绍 */
.series-intro {
  margin-top: 30rpx;
  text-align: center;
  padding: 40rpx 30rpx 20rpx 30rpx;
}

.series-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #e6a333;
  margin-bottom: 18rpx;
  letter-spacing: 2rpx;
  font-family: "FZLiBian", "FZLTXH--GBK1-0", "PingFang SC", sans-serif;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.6);
}

.series-desc {
  font-size: 28rpx;
  color: #5a4112;
  opacity: 0.85;
  line-height: 1.7;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.5);
}

/* 主推商品卡片 - 特别设计 */
.main-product-card {
  margin: 40rpx 30rpx 0 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(230, 163, 51, 0.12);
  overflow: hidden;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
  position: relative;
}

.main-product-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(230, 163, 51, 0.18);
}

.product-image-container {
  position: relative;
  width: 100%;
  height: 700rpx;
  overflow: hidden;
}

.main-product-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

/* 图片高亮效果 */
.highlight-effect {
  position: absolute;
  top: 0;
  left: -150%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(245, 201, 120, 0.3) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: skewX(-25deg);
  animation: shimmer 3s infinite;
  z-index: 2;
}

@keyframes shimmer {
  0% { left: -150%; }
  70% { left: 150%; }
  100% { left: 150%; }
}

.main-product-info {
  padding: 30rpx;
}

.main-product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.main-product-desc {
  font-size: 26rpx;
  color: #e6a333;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.main-product-full-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.view-detail {
  font-size: 24rpx;
  color: #e6a333;
  font-weight: bold;
}

/* 使用方法部分 */
.usage-section {
  margin: 50rpx 30rpx 0 30rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(5px);
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(230, 163, 51, 0.1);
}

.section-title {
  font-size: 32rpx;
  color: #5a4112;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 3rpx;
  background: #e6a333;
  border-radius: 3rpx;
}

.usage-steps {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.step {
  display: flex;
  align-items: flex-start;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  background: #e6a333;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-weight: bold;
  font-size: 28rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 相关产品 */
.related-products {
  margin: 50rpx 30rpx 0 30rpx;
}

.products {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.product-card {
  display: flex;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(230, 163, 51, 0.08);
  overflow: hidden;
  transition: all 0.2s;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(230, 163, 51, 0.12);
}

.product-image {
  width: 200rpx;
  height: 200rpx;
  object-fit: cover;
}

.product-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 购买按钮 */
.buy-section {
  margin: 60rpx 30rpx 30rpx 30rpx;
  text-align: center;
}

.buy-btn {
  background: linear-gradient(135deg, #e6a333, #f5c978);
  color: white;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(230, 163, 51, 0.3);
  width: 90%;
}

.buy-btn:active {
  opacity: 0.9;
  transform: translateY(2rpx);
}

/* 底部安全区域 */
.safe-bottom-area {
  height: 100rpx;
  width: 100%;
}

/* 创新：眼部装饰元素 */
.eye-decoration {
  position: fixed;
  width: 300rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(230, 163, 51, 0.15);
  z-index: 1;
  pointer-events: none;
}

.eye-decoration.left {
  top: -60rpx;
  left: -150rpx;
  transform: rotate(-20deg);
}

.eye-decoration.right {
  bottom: 100rpx;
  right: -150rpx;
  transform: rotate(15deg);
}

/* 添加眼睛中心装饰 */
.eye-decoration::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(230, 163, 51, 0.1);
  box-shadow: 0 0 30rpx 10rpx rgba(230, 163, 51, 0.1);
} 