<view class="message-center">
  <!-- 顶部选项卡 -->
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === index ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="index" 
      data-index="{{index}}" 
      bindtap="switchTab">
      {{item}}
    </view>
  </view>
  
  <!-- 消息列表 -->
  <view class="message-list">
    <!-- 头部操作栏 -->
    <view class="message-actions" wx:if="{{messages && messages.length > 0}}">
      <view class="action-btn" bindtap="markAllAsRead">
        <text>全部已读</text>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!messages || messages.length === 0 || (activeTab !== 0 && !messages.filter(item => item.type === activeTab).length)}}">
      <image class="empty-icon" src="/assets/icons/empty_message.png"></image>
      <text class="empty-text">暂无消息</text>
    </view>
    
    <!-- 消息列表 -->
    <view 
      class="message-item {{!item.isRead ? 'unread' : ''}}" 
      wx:for="{{messages}}" 
      wx:key="id"
      wx:if="{{activeTab === 0 || item.type === activeTab}}"
      bindtap="viewMessage"
      data-id="{{item.id}}">
      <view class="message-icon">
        <image src="{{item.icon}}" mode="aspectFit"></image>
        <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
      </view>
      <view class="message-content">
        <view class="message-title">{{item.title}}</view>
        <view class="message-text">{{item.content}}</view>
        <view class="message-date">{{item.date}}</view>
      </view>
      <view class="message-delete" catchtap="deleteMessage" data-id="{{item.id}}">
        <text>删除</text>
      </view>
    </view>
  </view>
</view> 