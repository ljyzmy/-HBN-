/* pages/member/rules/rules.wxss */
page {
  background-color: #f8f8f8;
}

.container {
  padding-bottom: 80rpx;
}

/* 头部样式 */
.header {
  position: relative;
  height: 260rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.header-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.header-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  background: linear-gradient(90deg, rgba(97, 138, 73, 0.8) 0%, rgba(0, 0, 0, 0.4) 100%);
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 选项卡样式 */
.tabs {
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #618a49;
  color: #fff;
  font-weight: 500;
}

/* 内容样式 */
.content {
  background-color: #fff;
  padding: 30rpx;
  margin: 0 20rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.rule-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 底部样式 */
.footer {
  padding: 30rpx 40rpx;
  text-align: center;
}

.footer-note {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.contact-btn {
  display: inline-block;
  background-color: #618a49;
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  margin-top: 20rpx;
  border: none;
} 