/* pages/classify/classify.wxss */
/* 重置容器样式，防止与app.wxss冲突 */
.page-container {
  height: 150vh;
  padding: 0;
  display: block;
  justify-content: initial;
  align-items: initial;
}

/* 容器样式 */
.container {
  padding: 0;
  background-color: #f8f8f8;
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 内容容器添加顶部间距 */
.content-container {
  padding-top: 180rpx; /* 与导航栏高度一致 */
  box-sizing: border-box;
  min-height: 100vh;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx 30rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: background-color 0.3s ease-in-out;
}

.nav-transparent {
  background-color: rgba(255, 255, 255, 0);
  backdrop-filter: blur(0);
  -webkit-backdrop-filter: blur(0);
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.search-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 130rpx;
  width: 240rpx;
}

.nav-placeholder {
  width: 80rpx;
}

/* 品牌介绍区样式 */
.brand-intro {
  background-color: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.brand-logo {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.brand-slogan {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 标签栏样式 */
.tab-container {
  background-color: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(84, 109, 86, 0.08);
  margin-bottom: 20rpx;
}

.tab-header {
  background-color: var(--dunhuang-beige);
  position: relative;
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 添加敦煌壁画装饰 */
.tab-header::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 60rpx;
  height: 100%;
  /* background-image: url('https://img.api.aa1.cn/2025/05/09/2b59632f2062b.png'); */
  background-repeat: repeat-y;
  background-size: 60rpx auto;
  opacity: 0.1;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: var(--dunhuang-red);
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: var(--dunhuang-red);
  border-radius: 3rpx;
}

.tab-content {
  padding: 30rpx;
}

/* 产品系列样式 */
.series-list {
  display: flex;
  flex-direction: column;
}

.series-item {
  margin-bottom: 40rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.series-item::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 100rpx;
  height: 100rpx;
  /* background-image: url('https://img.api.aa1.cn/2025/05/07/a80093e62c237.jpg'); */
  background-size: contain;
  background-repeat: no-repeat;
  background-position: top right;
  opacity: 0.06;
  z-index: 1;
}

.series-image {
  width: 100%;
  height: 380rpx;
}

.series-name {
  font-size: 32rpx;
  font-weight: bold;
  padding: 20rpx;
  background-color: var(--dunhuang-light);
  color: var(--dunhuang-brown);
}

.product-preview {
  display: flex;
  padding: 20rpx;
}

.preview-item {
  flex: 1;
  margin: 0 10rpx;
  text-align: center;
}

.preview-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.preview-name {
  font-size: 24rpx;
  color: #666;
}

/* 功效分类和适用人群分类样式 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* 一行两个 */
  gap: 20rpx; /* 网格间距 */
  padding: 0 20rpx; /* 左右边距 */
}

.category-item {
  position: relative;
  background-color: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(84, 109, 86, 0.08);
  transition: all 0.3s ease;
  width: 100%; /* 确保宽度自适应网格 */
}

.category-item:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 为抗老紧致系列添加特殊标记，更加突出 */
.category-item:first-child {
  border-left: 6rpx solid var(--cedar-medium);
}

.category-image {
  width: 100%;
  height: 280rpx; /* 稍微降低高度，适应两列布局 */
  object-fit: cover; /* 确保图片比例一致 */
}

.category-name {
  font-size: 28rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
  color: var(--cedar-dark);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis; /* 名称过长时显示省略号 */
}

/* 添加底部线条装饰 */
.category-name::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 3rpx;
  background-color: var(--cedar-light);
  opacity: 0.6;
}

/* 品牌理念展示 */
.brand-concept {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.concept-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.concept-list {
  display: flex;
  flex-direction: column;
}

.concept-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.concept-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: #618a49;
  border-radius: 50%;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 24rpx;
}

.concept-text {
  font-size: 28rpx;
  color: #666;
}

/* 添加视频组件样式 */
.series-video-container {
  position: relative;
  width: 100%;
  height: 400rpx;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(84, 109, 86, 0.1);
  border: 1px solid var(--dunhuang-beige);
}

.series-top-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(138, 99, 77, 0.7), transparent);
  color: #ffffff;
}

.video-title {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.video-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 为视频容器添加雪松装饰 */
.cedar-accent::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 100rpx;
  height: 100rpx;
  /* background-image: url('https://img.api.aa1.cn/2025/05/07/a80093e62c237.jpg'); */
  background-size: contain;
  background-repeat: no-repeat;
  background-position: top right;
  opacity: 0.15;
  z-index: 2;
  pointer-events: none;
}

/* 确保tab-container样式与整体风格一致 */
.tab-container {
  background-color: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(84, 109, 86, 0.08);
  margin-bottom: 20rpx;
}

.tab-header {
  background-color: var(--dunhuang-beige);
  position: relative;
}

/* 添加敦煌壁画装饰 */
.tab-header::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 60rpx;
  height: 100%;
  /* background-image: url('https://example.com/dunhuang-pattern.png'); */
  background-repeat: repeat-y;
  background-size: 60rpx auto;
  opacity: 0.1;
}

.tab-item.active {
  color: var(--dunhuang-red);
}

.tab-item.active::after {
  background-color: var(--dunhuang-red);
}

/* 添加滚动视图样式 */
.vertical-scroll {
  height: 90vh;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  position: relative;
  z-index: 5;
}

/* 底部安全区 */
.safe-bottom-area {
  height: 40rpx;
}

/* 分类页面字体修改 */
.tab-item, .series-name, .video-title, .video-subtitle, .product-name, .category-name, .brand-logo {
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

/* 类别标签字体 */
.tab-item.active {
  font-weight: 500;
}

/* 添加可点击项目样式 */
.clickable-item {
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.item-hover {
  transform: scale(0.97);
  box-shadow: 0 6rpx 20rpx rgba(84, 109, 86, 0.15);
}

/* 图片容器 */
.category-img-container {
  position: relative;
  overflow: hidden;
}

/* 添加悬停覆盖层 */
.category-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(84, 109, 86, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.clickable-item:active .category-overlay {
  opacity: 1;
}

/* 查看详情按钮 */
.view-more-btn {
  padding: 10rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--cedar-dark);
  font-size: 26rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

/* 小屏幕自适应调整 */
@media screen and (max-width: 320px) {
  .category-image {
    height: 240rpx; /* 在小屏幕上进一步降低高度 */
  }
  
  .category-name {
    font-size: 26rpx;
    padding: 16rpx 12rpx;
  }
}

/* 添加背景视频样式 */
.background-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  object-fit: cover;
  z-index: 0;
}

/* 视频覆盖层样式 */
.background-video-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, 
    rgba(249, 249, 247, 0.85), 
    rgba(249, 249, 247, 0.75),
    rgba(248, 245, 240, 0.85));
  z-index: 1;
}

/* 调整其他元素层级，确保它们显示在视频覆盖层上方 */
.custom-nav {
  z-index: 1000; /* 确保导航栏在顶层 */
}

.vertical-scroll {
  position: relative;
  z-index: 5; /* 确保滚动内容在视频覆盖层之上 */
}

/* 半透明化内容区块，使背景视频隐约可见 */
.tab-container {
  background-color: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.series-item {
  background-color: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.category-item {
  background-color: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.brand-intro {
  background-color: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* 确保导航栏透明效果与背景视频协调 */
.nav-transparent {
  background-color: rgba(255, 255, 255, 0);
  backdrop-filter: blur(0);
  -webkit-backdrop-filter: blur(0);
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}