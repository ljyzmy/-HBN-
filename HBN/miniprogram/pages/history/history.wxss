/* pages/history/history.wxss */

page {
  background-color: #f8f8f8;
  height: 100%;
}

.history-container {
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

/* 顶部操作栏样式 */
.action-bar {
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #eeeeee;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.right-actions {
  display: flex;
  align-items: center;
}

.clear-btn {
  font-size: 28rpx;
  color: #999;
  padding: 10rpx 20rpx;
  margin-right: 20rpx;
}

.edit-btn {
  font-size: 28rpx;
  color: #618a49;
  padding: 10rpx 20rpx;
  font-weight: 500;
}

/* 日期标题样式 */
.date-header {
  padding: 20rpx 30rpx;
  background-color: #f8f8f8;
  font-size: 28rpx;
  color: #666;
  position: sticky;
  top: 80rpx;
  z-index: 9;
  font-weight: 500;
}

/* 历史列表样式 */
.history-items {
  padding: 0 20rpx;
}

.history-item {
  display: flex;
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.item-hover {
  transform: scale(0.98);
  background-color: rgba(97, 138, 73, 0.05);
}

/* 选择框样式 */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  margin-right: 20rpx;
  margin-top: 60rpx;
  position: relative;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #618a49;
  border-color: #618a49;
  position: relative;
}

.checkbox.checked::after {
  content: "";
  position: absolute;
  width: 20rpx;
  height: 10rpx;
  border-left: 4rpx solid white;
  border-bottom: 4rpx solid white;
  top: 10rpx;
  left: 10rpx;
  transform: rotate(-45deg);
}

/* 商品图片样式 */
.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

/* 商品信息样式 */
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.delete-btn {
  color: #618a49;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid #618a49;
  border-radius: 30rpx;
  text-align: center;
  margin-left: 20rpx;
}

.product-category {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx;
  background-color: rgba(97, 138, 73, 0.08);
  border-radius: 20rpx;
  display: inline-block;
}

.price-container {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.price {
  font-size: 28rpx;
  color: #618a49;
  font-weight: 500;
  margin-right: 10rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.view-time {
  font-size: 22rpx;
  color: #999;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(97, 138, 73, 0.2);
  transition: all 0.3s;
}

.go-shopping-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.2);
}

/* 底部操作栏样式 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.select-all {
  display: flex;
  align-items: center;
}

.select-all text {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}

.batch-delete {
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(97, 138, 73, 0.2);
}

.batch-delete.disabled {
  background-color: #ddd;
  box-shadow: none;
}

/* 加载中状态样式 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #f3f3f3;
  border-top: 3rpx solid #618a49;
  border-radius: 50%;
  margin-right: 10rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.load-more text, .loading-state text {
  font-size: 26rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
} 