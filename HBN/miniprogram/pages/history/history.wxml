<view class="history-container">
  <!-- 顶部操作栏 -->
  <view class="action-bar">
    <text class="title">浏览历史 ({{history.length}})</text>
    <view class="right-actions">
      <text class="clear-btn" wx:if="{{!isEditMode && history.length > 0}}" bindtap="clearAllHistory">清空</text>
      <text class="edit-btn" bindtap="toggleEditMode" wx:if="{{history.length > 0}}">{{isEditMode ? '完成' : '管理'}}</text>
    </view>
  </view>

  <!-- 浏览历史列表（按日期分组） -->
  <view class="history-list" wx:if="{{history.length > 0}}">
    <block wx:for="{{groupedHistory}}" wx:for-item="group" wx:key="date">
      <!-- 日期标题 -->
      <view class="date-header">
        <text>{{group.formattedDate}}</text>
      </view>
      
      <!-- 当日浏览商品列表 -->
      <view class="history-items">
        <view class="history-item" wx:for="{{group.items}}" wx:key="_id" bindtap="viewProductDetail" data-id="{{item.productId}}" hover-class="item-hover">
          <!-- 选择框（编辑模式下显示） -->
          <view class="checkbox {{selectedItems.indexOf(item._id) > -1 ? 'checked' : ''}}" wx:if="{{isEditMode}}" catchtap="toggleSelectItem" data-id="{{item._id}}"></view>
          
          <!-- 商品图片 -->
          <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
          
          <!-- 商品信息 -->
          <view class="product-info">
            <view class="product-name-row">
              <text class="product-name">{{item.name}}</text>
              <view class="delete-btn" wx:if="{{isEditMode}}" catchtap="removeHistoryItem" data-id="{{item._id}}">
                <text>删除</text>
              </view>
            </view>
            <text class="product-category">{{item.category}}</text>
            <view class="price-container">
              <text class="price">¥{{item.price}}</text>
              <text class="original-price" wx:if="{{item.originalPrice > item.price}}">¥{{item.originalPrice}}</text>
            </view>
            <text class="view-time">浏览时间：{{item.timestamp.split(' ')[1]}}</text>
          </view>
        </view>
      </view>
    </block>
    
    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{isLoading && !isEditMode}}">
      <view class="loading-icon"></view>
      <text>加载中...</text>
    </view>
    
    <view class="no-more" wx:if="{{!hasMore && history.length > 0 && !isLoading && !isEditMode}}">
      <text>— 没有更多记录了 —</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!isLoading}}">
    <image class="empty-icon" src="{{emptyIconPath}}" mode="aspectFit"></image>
    <text class="empty-text">暂无浏览记录</text>
    <view class="go-shopping-btn" bindtap="goShopping">
      <text>去逛逛</text>
    </view>
  </view>
  
  <!-- 加载中状态 -->
  <view class="loading-state" wx:if="{{isLoading && history.length === 0}}">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>

  <!-- 底部操作栏（编辑模式） -->
  <view class="bottom-action-bar" wx:if="{{isEditMode && history.length > 0}}">
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="checkbox {{selectedItems.length === history.length ? 'checked' : ''}}"></view>
      <text>全选</text>
    </view>
    <view class="batch-delete {{selectedItems.length === 0 ? 'disabled' : ''}}" bindtap="batchRemoveHistory">
      <text>删除 ({{selectedItems.length}})</text>
    </view>
  </view>
</view> 