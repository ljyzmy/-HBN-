/* pages/logistics/detail.wxss */

/* 基础变量 */
page {
  --color-primary: #618a49;
  --color-secondary: #8aad75;
  --color-danger: #a64036;
  --color-warning: #cf985c;
  --color-background: #f8f8f8;
  --color-text: #333;
  --color-text-light: #666;
  --color-text-lighter: #999;
  --color-border: #eee;
  --radius-small: 8rpx;
  --radius-medium: 16rpx;
  --radius-large: 24rpx;
  --shadow-small: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  --shadow-medium: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-large: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  --transition-fast: all 0.2s ease;
  --transition-normal: all 0.3s ease;
  background-color: var(--color-background);
}

.container {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  z-index: 1000;
  box-shadow: var(--shadow-small);
  box-sizing: border-box;
  padding: 0 30rpx;
}

.nav-back {
  width: 80rpx;
  height: 44px;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--color-text);
}

.nav-placeholder {
  width: 80rpx;
  height: 44px;
}

/* 顶部安全区域 */
.safe-top {
  width: 100%;
}

/* 底部安全区域 */
.safe-bottom {
  width: 100%;
  height: 40rpx;
}

/* 内容区域 */
.content-container {
  width: 100%;
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 加载中样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.loading-spinner {
  width: 100%;
  height: 100%;
  border: 6rpx solid rgba(97, 138, 73, 0.1);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-light);
}

/* 物流信息头部 */
.logistics-header {
  background-color: #fff;
  border-radius: var(--radius-large);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-small);
}

.status-section {
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.delivery-company {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.tracking-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 15rpx 0;
  border-top: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
}

.tracking-label {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.tracking-number {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  margin-right: 20rpx;
}

.copy-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: 28rpx;
}

.contact-section {
  display: flex;
  justify-content: flex-end;
}

.contact-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.contact-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.contact-btn text {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* 物流跟踪 */
.tracking-container {
  background-color: #fff;
  border-radius: var(--radius-large);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-small);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.tracking-timeline {
  padding: 10rpx 0;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 30rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ccc;
  border-radius: 50%;
}

.timeline-line {
  position: absolute;
  left: 8rpx;
  top: 26rpx;
  width: 1px;
  height: calc(100% - 16rpx);
  background-color: #eee;
}

.timeline-content {
  padding-left: 20rpx;
}

.timeline-status {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.timeline-desc {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-bottom: 6rpx;
}

.timeline-address {
  font-size: 24rpx;
  color: var(--color-text-lighter);
  margin-bottom: 6rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: var(--color-text-lighter);
}

.timeline-item.active .timeline-dot {
  background-color: var(--color-primary);
  width: 20rpx;
  height: 20rpx;
  top: 8rpx;
}

.timeline-item.active .timeline-status {
  color: var(--color-primary);
}

/* 商品信息 */
.product-section {
  background-color: #fff;
  border-radius: var(--radius-large);
  padding: 30rpx;
  box-shadow: var(--shadow-small);
}

.product-item {
  display: flex;
  padding: 20rpx 0;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-small);
  margin-right: 20rpx;
  background-color: #f9f9f9;
  border: 1rpx solid var(--color-border);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-specs {
  font-size: 24rpx;
  color: var(--color-text-lighter);
  margin-bottom: 10rpx;
}

.product-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 500;
}

.product-quantity {
  font-size: 26rpx;
  color: var(--color-text-lighter);
} 