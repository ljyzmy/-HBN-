/* pages/login/login.wxss */

.login-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FFFFFF;
  padding: 0 40rpx;
}

/* Logo部分 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.slogan {
  font-size: 28rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

/* 表单部分 */
.login-form {
  width: 100%;
}

.input-group {
  position: relative;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #EEEEEE;
  padding-bottom: 16rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.input-group input {
  height: 50rpx;
  font-size: 30rpx;
  color: #333333;
  width: 100%;
}

/* 验证码按钮 */
.code-group {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.code-group input {
  width: 60%;
}

.code-btn {
  width: 35%;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #618a49, #8aad75);
  border-radius: 30rpx;
  padding: 0;
  margin: 0;
}

.code-btn.disabled {
  background: #CCCCCC;
  color: #FFFFFF;
}

/* 切换登录方式 */
.switch-type {
  text-align: right;
  font-size: 26rpx;
  color: #618a49;
  margin-bottom: 40rpx;
}

/* 协议部分 */
.protocol-section {
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
}

.checkbox-container {
  margin-right: 20rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #DDDDDD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  border-color: #618a49;
  background-color: #618a49;
}

.check-icon {
  width: 20rpx;
  height: 12rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg);
}

.protocol-text {
  font-size: 24rpx;
  color: #999999;
  flex: 1;
}

.protocol-link {
  color: #618a49;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 8rpx 20rpx rgba(97, 138, 73, 0.3);
}

/* 第三方登录 */
.third-party-login {
  margin-top: 30rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background-color: #EEEEEE;
}

.divider .text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #999999;
}

.icon-group {
  display: flex;
  justify-content: space-around;
  padding: 0 60rpx;
}

.icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wechat-icon, .qq-icon, .weibo-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 15rpx;
  background-size: 50rpx;
  background-position: center;
  background-repeat: no-repeat;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

