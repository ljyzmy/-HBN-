  background-color: rgba(0, 103, 236, 0.1);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%230067EC"><path d="M21.2,3.4C20.5,2.7 19.4,2.4 18.2,2.4C17,2.4 15.7,2.8 14.3,3.2C13,3.7 11.6,4.2 10.1,4.2C8.6,4.2 7.2,3.7 5.9,3.2C5.1,3 4.3,2.7 3.5,2.5C3.5,2.8 3.5,3.1 3.5,3.4C3.5,10.6 8.4,16.7 15,19.2V14.7H14.6C9.6,14.7 6.3,11.7 5.9,11.2C5.8,11.1 5.8,11 5.9,10.9L6.1,10.7C6.2,10.6 6.3,10.6 6.4,10.7C6.55,10.8 9.7,13.4 14.6,13.4H17C20.3,10.8 22,7.2 21.6,3.8C21.5,3.7 21.3,3.5 21.2,3.4Z" /></svg>');
}

.payment-icon.bank {
  background-color: rgba(207, 152, 92, 0.1);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23CF985C"><path d="M11.5,1L2,6V8H21V6M16,10V17H19V10M2,22H21V19H2M10,10V17H13V10M4,10V17H7V10H4Z" /></svg>');
}

.payment-name {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.payment-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #618a49;
  position: relative;
}

.payment-check::before {
  content: '';
  width: 20rpx;
  height: 10rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  position: absolute;
  top: 12rpx;
  left: 10rpx;
}

/* 充值说明 */
.notice-section {
  padding: 20rpx 30rpx;
  margin: 0 30rpx;
}

.notice-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 30rpx;
  margin-top: 30rpx;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ccc;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  transition: all 0.3s;
}

.submit-btn.active {
  background: linear-gradient(135deg, #618a49, #8aaa75);
  box-shadow: 0 8rpx 16rpx rgba(97, 138, 73, 0.2);
}

button[disabled].submit-btn {
  background-color: #ccc;
  color: #fff;
} 