/* 容器样式 */
.recharge-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 40rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: sticky;
  top: 0;
  height: 90rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.nav-back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23333333"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>');
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.nav-placeholder {
  width: 70rpx;
}

/* 成功提示 */
.success-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  z-index: 10;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: rgba(97, 138, 73, 0.1);
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.success-icon::before {
  content: '';
  width: 60rpx;
  height: 30rpx;
  border-left: 6rpx solid #618a49;
  border-bottom: 6rpx solid #618a49;
  transform: rotate(-45deg);
  position: absolute;
  top: 40rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.success-desc {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.success-balance {
  font-size: 28rpx;
  color: #999;
}

/* 余额展示 */
.balance-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.balance-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.balance-value {
  font-size: 60rpx;
  font-weight: 500;
  color: #333;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

/* 金额选择 */
.amount-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 30rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.amount-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #333;
  transition: all 0.3s;
  position: relative;
  border: 2rpx solid transparent;
}

.amount-item.selected {
  background-color: rgba(97, 138, 73, 0.1);
  border-color: #618a49;
  color: #618a49;
}

.amount-item.custom {
  color: #999;
}

.custom-input {
  width: 100%;
  height: 100%;
  text-align: center;
}

/* 支付方式 */
.payment-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.payment-list {
  display: flex;
  flex-direction: column;
}

.payment-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.payment-item:last-child {
  border-bottom: none;
}

.payment-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
  background-size: 60rpx;
  background-position: center;
  background-repeat: no-repeat;
}

