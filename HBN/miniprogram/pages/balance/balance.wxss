/* 容器样式 */
.balance-container { 
  display: flex; 
  flex-direction: column; 
  min-height: 100vh; 
  background-color: #f8f8f8; 
  padding: 30rpx; 
}

/* 余额卡片样式 */
.balance-card {
  background: linear-gradient(135deg, #618a49, #8aaa75);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(97, 138, 73, 0.3);
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
}

.balance-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="150" height="150" viewBox="0 0 100 100"><path fill="rgba(255,255,255,0.05)" d="M50 0 L100 50 L50 100 L0 50 Z"/></svg>');
  background-repeat: repeat;
  background-size: 60rpx;
  opacity: 0.2;
}

.balance-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.balance-title {
  font-size: 28rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.balance-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-top: 30rpx;
  width: 100%;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  padding-top: 30rpx;
}

.action-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  width: 100%;
}

.action-btn.recharge {
  background-color: rgba(255, 255, 255, 0.25);
}

.action-btn.withdraw {
  background-color: rgba(255, 255, 255, 0.15);
}

.action-btn:active {
  transform: scale(0.98);
  background-color: rgba(255, 255, 255, 0.3);
}

.balance-amount {
  font-size: 72rpx;
  font-weight: 500;
  margin: 10rpx 0 20rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
  font-family: "DIN Alternate", "DIN-Regular", "PingFang SC", sans-serif;
}

.balance-detail {
  display: flex;
  justify-content: space-between;
  margin-top: 15rpx;
  position: relative;
  z-index: 1;
}

.balance-item {
  display: flex;
  flex-direction: column;
}

.balance-item .label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.balance-item .value {
  font-size: 32rpx;
  font-weight: 500;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

/* 收支统计卡片 */
.balance-stats {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(to bottom, transparent, #eee, transparent);
}

.stats-value {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

.stats-value.income {
  color: #618a49;
}

.stats-value.expense {
  color: #a64036;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

/* 标签栏 */
.transaction-tabs {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s ease;
}

.tab.active {
  color: #618a49;
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 30%;
  width: 40%;
  height: 6rpx;
  background-color: #618a49;
  border-radius: 3rpx;
}

.filter-btn {
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23666"><path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>');
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  margin-left: 4rpx;
}

/* 交易记录部分 */
.transactions-section {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  flex: 1;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.transaction-list {
  padding: 10rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 交易项样式 */
.transaction-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.transaction-item:active {
  background-color: #f9f9f9;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-left {
  margin-right: 20rpx;
}

.transaction-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  background-size: 40rpx;
  background-position: center;
  background-repeat: no-repeat;
}

/* 交易类型图标 */
.transaction-icon.type-1 {
  background-color: rgba(97, 138, 73, 0.1);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23618a49"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>');
}

.transaction-icon.type-2 {
  background-color: rgba(166, 64, 54, 0.1);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23a64036"><path d="M19.77 7.23l.01-.01-3.72-3.72L15 4.56l2.11 2.11c-.94.36-1.61 1.26-1.61 2.33 0 1.38 1.12 2.5 2.5 2.5.36 0 .69-.08 1-.21v7.21c0 .55-.45 1-1 1s-1-.45-1-1V14c0-1.1-.9-2-2-2h-1V5c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v16h10v-7.5h1.5v5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V9c0-.69-.28-1.32-.73-1.77zM18 10c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM8 18v-4.5H6L10 6v5h2l-4 7z"/></svg>');
}

.transaction-icon.type-3 {
  background-color: rgba(207, 152, 92, 0.1);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23cf985c"><path d="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/></svg>');
}

.transaction-icon.type-4 {
  background-color: rgba(128, 128, 128, 0.1);
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23666666"><path d="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z"/></svg>');
}

.transaction-info {
  flex: 1;
}

.transaction-desc {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.transaction-date {
  font-size: 24rpx;
  color: #999;
}

.transaction-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}

.transaction-amount {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
  font-family: "DIN Alternate", "DIN-Regular", sans-serif;
}

.transaction-amount.income {
  color: #618a49;
}

.transaction-amount.expense {
  color: #a64036;
}

.transaction-status {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.transaction-status.status-1 {
  color: #618a49;
  background-color: rgba(97, 138, 73, 0.1);
}

.transaction-status.status-2 {
  color: #cf985c;
  background-color: rgba(207, 152, 92, 0.1);
}

.transaction-status.status-3 {
  color: #a64036;
  background-color: rgba(166, 64, 54, 0.1);
}

/* 加载更多和没有更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  border: 3rpx solid #eee;
  border-top: 3rpx solid #618a49;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 筛选弹窗 */
.filter-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.filter-popup.show {
  visibility: visible;
  opacity: 1;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding: 40rpx 30rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.filter-popup.show .popup-content {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #999;
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.filter-option {
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-option.active {
  background-color: rgba(97, 138, 73, 0.1);
  color: #618a49;
  font-weight: 500;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.filter-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.filter-btn.reset {
  background-color: #f5f5f5;
  color: #666;
}

.filter-btn.confirm {
  background: linear-gradient(135deg, #618a49, #8aaa75);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(97, 138, 73, 0.2);
}

/* 动画效果 */
.hover-scale {
  transition: all 0.3s ease;
}

.hover-scale:active {
  transform: scale(0.98);
}
