<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/返回.png" mode="aspectFit" class="back-icon"></image>
    </view>
    <view class="nav-title">订单详情</view>
    <view class="nav-placeholder"></view>
  </view>
  
  <!-- 顶部安全区域 -->
  <view class="safe-top" style="height: {{navHeight}}px;"></view>
  
  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading">
      <view class="loading-spinner"></view>
    </view>
    <view class="loading-text">加载中...</view>
  </view>
  
  <!-- 订单详情内容 -->
  <block wx:else>
    <!-- 订单状态 -->
    <view class="status-section">
      <view class="status-row">
        <view class="status-icon">
          <!-- 根据订单状态显示不同图标 -->
          <block wx:if="{{order.status === 'unpaid'}}">
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/待付款.png" class="status-img"></image>
          </block>
          <block wx:elif="{{order.status === 'unshipped'}}">
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/待发货.png" class="status-img"></image>
          </block>
          <block wx:elif="{{order.status === 'shipped'}}">
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/待收货.png" class="status-img"></image>
          </block>
          <block wx:elif="{{order.status === 'completed'}}">
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/已完成.png" class="status-img"></image>
          </block>
          <block wx:elif="{{order.status === 'canceled'}}">
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/取消.png" class="status-img"></image>
          </block>
          <block wx:elif="{{order.status === 'afterSale'}}">
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/售后.png" class="status-img"></image>
          </block>
          <block wx:else>
            <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/待付款.png" class="status-img"></image>
          </block>
        </view>
        <view class="status-info">
          <view class="status-text {{order.status === 'unpaid' ? 'status-unpaid' : ''}}">{{order.statusText}}</view>
          
          <!-- 待付款倒计时 -->
          <view class="status-desc" wx:if="{{order.status === 'unpaid'}}">
            剩余支付时间：{{countdownTime}}
          </view>
          
          <!-- 待发货描述 -->
          <view class="status-desc" wx:elif="{{order.status === 'unshipped'}}">
            商家正在处理您的订单
          </view>
          
          <!-- 待收货描述 -->
          <view class="status-desc" wx:elif="{{order.status === 'shipped'}}">
            商品正在配送中，请耐心等待
          </view>
          
          <!-- 已完成描述 -->
          <view class="status-desc" wx:elif="{{order.status === 'completed'}}">
            订单已完成，感谢您的购买
          </view>
          
          <!-- 已取消描述 -->
          <view class="status-desc" wx:elif="{{order.status === 'canceled'}}">
            订单已取消
          </view>
          
          <!-- 售后中描述 -->
          <view class="status-desc" wx:elif="{{order.status === 'afterSale'}}">
            售后申请处理中
          </view>
        </view>
      </view>
    </view>
    
    <!-- 收货地址 -->
    <view class="address-section section-card">
      <view class="section-title">
        <view class="title-icon">
          <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/收货地址.png" class="title-img"></image>
        </view>
        <view class="title-text">收货信息</view>
      </view>
      <view class="address-info">
        <view class="address-row">
          <text class="address-name">张三</text>
          <text class="address-phone">138****5678</text>
        </view>
        <view class="address-detail">广东省广州市天河区体育西路101号HBN大厦5楼</view>
      </view>
    </view>
    
    <!-- 物流信息（如果已发货） -->
    <view class="logistics-section section-card" wx:if="{{order.status === 'shipped' || order.status === 'completed'}}">
      <view class="section-title" bindtap="showLogistics">
        <view class="title-icon">
          <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/售后.png" class="title-img"></image>
        </view>
        <view class="title-text">物流信息</view>
        <view class="title-right">
          <text>查看详情</text>
          <view class="right-arrow"></view>
        </view>
      </view>
      <view class="logistics-info">
        <view class="logistics-company">
          <text>{{order.logistics.company}}</text>
          <text class="logistics-number">{{order.logistics.number}}</text>
          <view class="copy-btn" bindtap="copyTrackingNumber">复制</view>
        </view>
        <view class="logistics-status" wx:if="{{logistics.traces && logistics.traces.length > 0}}">
          {{logistics.traces[0].content}}
        </view>
      </view>
    </view>
    
    <!-- 商品信息 -->
    <view class="product-section section-card">
      <view class="section-title">
        <view class="title-icon">
          <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/个人资料.png" class="title-img"></image>
        </view>
        <view class="title-text">商品信息</view>
      </view>
      <view class="product-card">
        <image class="product-image" src="{{order.product.image}}" mode="aspectFill"></image>
        <view class="product-info">
          <view class="product-name">{{order.product.name}}</view>
          <view class="product-specs">
            <text wx:for="{{order.product.specs}}" wx:for-item="spec" wx:for-index="key" wx:key="key">
              {{key}}:{{spec}}{{index < Object.keys(order.product.specs).length-1 ? ' | ' : ''}}
            </text>
          </view>
          <view class="product-price-row">
            <text class="product-price">¥{{order.product.price}}</text>
            <text class="product-quantity">x{{order.product.quantity}}</text>
          </view>
        </view>
      </view>
      
      <!-- 商品合计 -->
      <view class="product-total">
        <text class="total-label">共{{order.product.quantity}}件商品，合计：</text>
        <text class="total-value">¥{{order.totalAmount}}</text>
      </view>
    </view>
    
    <!-- 订单信息 -->
    <view class="order-info-section section-card">
      <view class="section-title">
        <view class="title-icon">
          <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/售后.png" class="title-img"></image>
        </view>
        <view class="title-text">订单信息</view>
      </view>
      <view class="info-list">
        <view class="info-item">
          <text class="info-label">订单编号</text>
          <view class="info-value-row">
            <text class="info-value">{{order.orderNumber}}</text>
            <view class="copy-btn" bindtap="copyOrderNumber">复制</view>
          </view>
        </view>
        <view class="info-item">
          <text class="info-label">下单时间</text>
          <text class="info-value">{{order.createTime}}</text>
        </view>
        <view class="info-item" wx:if="{{order.payTime}}">
          <text class="info-label">支付时间</text>
          <text class="info-value">{{order.payTime}}</text>
        </view>
        <view class="info-item" wx:if="{{order.payMethod}}">
          <text class="info-label">支付方式</text>
          <text class="info-value">{{order.payMethod}}</text>
        </view>
        <view class="info-item" wx:if="{{order.status === 'shipped' && order.estimateDeliveryTime}}">
          <text class="info-label">预计送达</text>
          <text class="info-value">{{order.estimateDeliveryTime}}</text>
        </view>
        <view class="info-item" wx:if="{{order.completeTime}}">
          <text class="info-label">完成时间</text>
          <text class="info-value">{{order.completeTime}}</text>
        </view>
        <view class="info-item" wx:if="{{order.cancelTime}}">
          <text class="info-label">取消时间</text>
          <text class="info-value">{{order.cancelTime}}</text>
        </view>
      </view>
    </view>
    
    <!-- 售后信息（如果有） -->
    <view class="after-sale-section section-card" wx:if="{{order.status === 'afterSale' && afterSale}}">
      <view class="section-title">
        <view class="title-icon">
          <image src="cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/图标/售后.png" class="title-img"></image>
        </view>
        <view class="title-text">售后信息</view>
      </view>
      <view class="info-list">
        <view class="info-item">
          <text class="info-label">售后单号</text>
          <text class="info-value">{{afterSale.id}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">售后类型</text>
          <text class="info-value">{{afterSale.type}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">申请原因</text>
          <text class="info-value">{{afterSale.reason}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">退款金额</text>
          <text class="info-value">¥{{afterSale.amount}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">申请时间</text>
          <text class="info-value">{{afterSale.createTime}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">处理状态</text>
          <text class="info-value">{{afterSale.status}}</text>
        </view>
      </view>
    </view>
    
    <!-- 底部操作区 -->
    <view class="bottom-action-area">
      <!-- 待付款状态 -->
      <block wx:if="{{order.status === 'unpaid'}}">
        <view class="action-btn secondary" bindtap="cancelOrder">取消订单</view>
        <view class="action-btn primary" bindtap="goToPay">立即付款</view>
      </block>
      
      <!-- 待发货状态 -->
      <block wx:elif="{{order.status === 'unshipped'}}">
        <view class="action-btn secondary" bindtap="contactCustomerService">联系客服</view>
      </block>
      
      <!-- 待收货状态 -->
      <block wx:elif="{{order.status === 'shipped'}}">
        <view class="action-btn secondary" bindtap="viewLogistics">查看物流</view>
        <view class="action-btn primary" bindtap="confirmReceive">确认收货</view>
      </block>
      
      <!-- 已完成状态 -->
      <block wx:elif="{{order.status === 'completed'}}">
        <view class="action-btn secondary" bindtap="applyAfterSale">申请售后</view>
        <view class="action-btn secondary" bindtap="goToRate">去评价</view>
        <view class="action-btn primary" bindtap="contactCustomerService">联系客服</view>
      </block>
      
      <!-- 已取消状态 -->
      <block wx:elif="{{order.status === 'canceled'}}">
        <view class="action-btn secondary" bindtap="contactCustomerService">联系客服</view>
      </block>
      
      <!-- 售后中状态 -->
      <block wx:elif="{{order.status === 'afterSale'}}">
        <view class="action-btn secondary" bindtap="contactCustomerService">联系客服</view>
      </block>
    </view>
  </block>
  
  <!-- 物流详情弹窗 -->
  <view class="logistics-popup {{logisticsVisible ? 'popup-show' : ''}}" catchtouchmove="preventTouchMove">
    <view class="popup-mask" bindtap="hideLogistics"></view>
    <view class="popup-content">
      <view class="popup-header">
        <view class="popup-title">物流详情</view>
        <view class="popup-close" bindtap="hideLogistics">×</view>
      </view>
      <view class="company-info">
        <text class="company-name">{{order.logistics.company}}</text>
        <text class="tracking-number">{{order.logistics.number}}</text>
      </view>
      <view class="logistics-timeline">
        <view 
          class="timeline-item {{index === 0 ? 'active' : ''}}" 
          wx:for="{{logistics.traces}}" 
          wx:key="index">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <view class="timeline-time">{{item.time}}</view>
            <view class="timeline-text">{{item.content}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部安全区域 -->
  <view class="safe-bottom"></view>
</view> 