/* pages/product/list.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background-color: var(--background-color);
}

/* 重置容器样式，防止与app.wxss冲突 */
.page-container {
  height: 100vh;
  padding: 0;
  display: block;
  justify-content: initial;
  align-items: initial;
}

/* 容器样式 */
.container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 添加内容容器样式 */
.content-container {
  padding-top: 180rpx; /* 与导航栏高度一致 */
  box-sizing: border-box;
  min-height: 100vh;
}

/* 自定义导航栏 - 参考detail页面样式 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.nav-transparent {
  background-color: transparent;
}

.nav-opaque {
  /* 删除背景但保留微弱阴影以增强可见性 */
  background-color: transparent;
  box-shadow: 0 2rpx 10rpx rgba(120, 90, 77, 0.08);
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 130rpx;
  width: 240rpx;
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容滚动区域 */
.content-scroll {
  height: 100vh;
  position: relative;
}

/* 内容容器 */
.content-container {
  padding-top: 180rpx;
  box-sizing: border-box;
}

/* 分类横向滚动 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 20rpx 0;
  position: relative;
  z-index: 100;
  box-shadow: 0 4rpx 20rpx rgba(120, 90, 77, 0.05);
}

.category-tabs {
  display: flex;
  padding: 0 30rpx;
}

.category-tab {
  font-size: 28rpx;
  padding: 12rpx 30rpx;
  margin-right: 20rpx;
  color: var(--text-secondary);
  background-color: var(--background-color);
  border-radius: 30rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  position: relative;
  overflow: hidden;
}

.category-tab::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 3rpx;
  background-color: var(--accent-color);
  transition: all 0.3s ease;
  transform: translateX(-50%);
}

.category-tab.active {
  background-color: var(--primary-color);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(120, 90, 77, 0.2);
}

.category-tab.active::after {
  width: 30rpx;
}

/* 系列介绍 - 增加高度 */
.category-intro {
  position: relative;
  height: 380rpx; /* 从原来的280rpx增加到380rpx */
  overflow: hidden;
  margin: 30rpx 30rpx 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(84, 109, 86, 0.08);
}

.intro-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 视频背景样式 */
.intro-bg-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

/* 视频叠加层，增强文字可读性 */
.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(210, 192, 178, 0.7), rgba(249, 247, 245, 0.7));
  z-index: 2;
  mix-blend-mode: multiply;
}

.cedar-accent::before {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  background-image: url('cloud://cloud1-0gxff61z2804383c.636c-cloud1-0gxff61z2804383c-1333491872/分类背景.png');
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0.2;
  z-index: 3;
}

/* 修改内容区域，移至底部并添加半透明背景 */
.intro-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 4;
  padding: 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  background: linear-gradient(to top, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.6) 70%, rgba(255, 255, 255, 0));
  border-radius: 0 0 16rpx 16rpx;
}

/* 标题样式优化 */
.intro-title {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--text-primary, #4a3c32);
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  position: relative;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.8); /* 淡化文字阴影 */
}

.intro-title::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 60rpx;
  height: 4rpx;
  background-color: var(--accent-color, #c98c60);
  border-radius: 2rpx;
}

/* 描述文字样式优化 */
.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary, #7d685a);
  line-height: 1.8; /* 增加行高 */
  max-width: 100%;
  text-shadow: none; /* 移除文字阴影，因为有背景了 */
  margin-bottom: 10rpx; /* 添加底部间距 */
}

/* 筛选栏布局优化 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  margin: 0 30rpx 30rpx;
  background-color: var(--card-color);
  border-radius: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 77, 0.08);
  transition: all 0.3s ease;
  z-index: 100;
}

.filter-bar.fixed {
  position: fixed;
  top: 260rpx;
  left: 0;
  right: 0;
  margin: 0;
  border-radius: 0;
  box-shadow: 0 4rpx 16rpx rgba(120, 90, 77, 0.1);
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  z-index: 99;
}

/* 搜索区域扩展 */
.search-wrapper {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: var(--background-color);
  border-radius: 30rpx;
  flex: 1; /* 改为flex: 1，使其占据可用空间 */
  max-width: 60%; /* 限制最大宽度 */
  margin-right: 20rpx; /* 添加右侧间距 */
  transition: all 0.3s ease;
}

.search-wrapper:active {
  opacity: 0.8;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23666666"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 0 0 1.48-5.34c-.47-2.78-2.79-5-5.59-5.34a6.505 6.505 0 0 0-7.27 7.27c.34 2.8 2.56 5.12 5.34 5.59a6.5 6.5 0 0 0 5.34-1.48l.27.28v.79l4.25 4.25c.41.41 1.08.41 1.49 0 .41-.41.41-1.08 0-1.49L15.5 14zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>');
  background-size: contain;
  background-repeat: no-repeat;
  margin-right: 8rpx;
  flex-shrink: 0; /* 防止图标被压缩 */
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 100%;
  border: none;
  outline: none;
  background: transparent;
}

/* 搜索输入框占位符样式 */
.search-input-placeholder {
  color: #999;
  font-size: 24rpx;
}

/* 清除按钮样式 */
.search-clear {
  width: 32rpx;
  height: 32rpx;
  padding: 4rpx;
  margin-left: 6rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.05);
}

.search-clear-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 排序选项调整 */
.sort-options {
  display: flex;
  align-items: center;
  flex-shrink: 0; /* 防止排序选项被压缩 */
}

.sort-option {
  font-size: 26rpx;
  color: #666;
  margin-left: 20rpx; /* 减小左侧间距 */
  position: relative;
  padding: 10rpx 8rpx; /* 减小内边距 */
  transition: all 0.3s ease;
}

.sort-option.active {
  color: var(--primary-color, #a08679);
  font-weight: 500;
}

.sort-option.active .sort-text {
  position: relative;
  z-index: 2;
}

.sort-indicator {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 4rpx;
  background-color: var(--primary-color, #a08679);
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

/* 排序选项点击反馈 */
.sort-option:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.price-sort {
  display: flex;
  align-items: center;
}

.price-arrow {
  width: 16rpx;
  height: 16rpx;
  margin-left: 6rpx;
  position: relative;
  transition: transform 0.3s ease;
}

.price-arrow::before,
.price-arrow::after {
  content: '';
  position: absolute;
  left: 50%;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  transition: all 0.3s ease;
}

.price-arrow::before {
  top: 0;
  border-bottom: 5rpx solid #ccc;
}

.price-arrow::after {
  bottom: 0;
  border-top: 5rpx solid #ccc;
}

.price-arrow.asc::before {
  border-bottom-color: var(--primary-color);
}

.price-arrow.desc::after {
  border-top-color: var(--primary-color);
}

/* 产品列表 */
.product-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  padding: 0 30rpx;
}

.product-item {
  border-radius: 16rpx;
  background-color: var(--dunhuang-light);
  box-shadow: 0 4rpx 16rpx rgba(138, 99, 77, 0.1);
  position: relative;
  overflow: hidden;
}

.product-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(to right, var(--dunhuang-red), var(--dunhuang-orange), transparent);
}

.product-card:active {
  transform: scale(0.98);
}

.product-media-container {
  width: 100%;
  height: 320rpx;
  position: relative;
  overflow: hidden;
  background-color: #f6f6f6;
}

.product-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  animation: videoFadeIn 0.5s ease forwards;
}

@keyframes videoFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.product-image {
  width: 100%;
  height: 320rpx;
  background-color: #f6f6f6;
  display: none; /* 隐藏图片 */
}

.product-info {
  padding: 20rpx;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.product-tag {
  font-size: 20rpx;
  color: rgba(166, 64, 54, 0.9);
  background-color: rgba(166, 64, 54, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-price-row {
  display: flex;
  align-items: baseline;
}

.product-price {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--primary-dark);
  margin-right: 12rpx;
}

.product-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.product-sale {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 购物车浮窗球 */
.cart-float {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(to right, var(--primary-color), var(--primary-light));
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(160, 134, 121, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: all 0.3s ease;
}

.cart-float:active {
  transform: scale(0.95);
}

.cart-icon {
  width: 50rpx;
  height: 50rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ffffff"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49a1 1 0 0 0-.87-1.48H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>');
  background-size: contain;
  background-repeat: no-repeat;
}

/* 智能浮窗球 */
.ai-float {
  position: fixed;
  right: 30rpx;
  bottom: 240rpx; /* 购物车浮窗球位置 + 浮窗球尺寸 + 间距 */
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(to right, var(--accent-color), var(--accent-light));
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(201, 140, 96, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: all 0.3s ease;
}

.ai-float:active {
  transform: scale(0.95);
}

.ai-icon {
  width: 50rpx;
  height: 50rpx;
}

.cart-badge {
  display: none; /* 隐藏徽章 */
}

/* 底部留白 */
.bottom-space {
  height: 120rpx;
}

/* 小屏幕自适应 */
@media screen and (max-width: 320px) {
  .product-media-container {
    height: 280rpx;
  }
  
  .category-tab {
    font-size: 24rpx;
    padding: 10rpx 24rpx;
  }
  
  .product-name {
    font-size: 26rpx;
  }
}

/* 空状态提示 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

@keyframes fadeInStagger {
  from { 
    opacity: 0; 
    transform: translateY(30rpx); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0); 
  }
}

/* 分类标签样式 */
.category-item.active {
  color: var(--dunhuang-red);
  border-bottom: 4rpx solid var(--dunhuang-red);
}

/* 筛选按钮 */
.filter-button {
  background-color: var(--dunhuang-beige);
  color: var(--dunhuang-brown);
}

/* 添加不同分类的产品卡片样式 */
/* 抗老紧致系列卡片 */
.antiaging-card {
  border-radius: 16rpx;
  background-color: var(--card-color);
  box-shadow: 0 4rpx 16rpx rgba(160, 134, 121, 0.1);
  position: relative;
  overflow: hidden;
}

.antiaging-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(to right, var(--primary-dark), var(--accent-color), transparent);
}

/* 美白焕亮系列卡片 */
.whitening-card {
  border-radius: 16rpx;
  background-color: #f9f8fc;
  box-shadow: 0 4rpx 16rpx rgba(160, 134, 121, 0.1);
  position: relative;
  overflow: hidden;
}

.whitening-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(to right, #a08679, #d2c0b2, transparent);
}

.tag-whitening {
  color: #ffffff !important;
  background-color: rgba(142, 124, 195, 0.9) !important;
}

/* 维护保湿系列卡片 */
.hydrating-card {
  border-radius: 16rpx;
  background-color: #f7fcff;
  box-shadow: 0 4rpx 16rpx rgba(160, 134, 121, 0.1);
  position: relative;
  overflow: hidden;
}

.hydrating-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(to right, #a08679, #e6c9b7, transparent);
}

.tag-hydrating {
  color: #ffffff !important;
  background-color: rgba(107, 165, 214, 0.9) !important;
}

/* 基础护肤系列卡片 */
.basic-card {
  border-radius: 16rpx;
  background-color: #f9fcf7;
  box-shadow: 0 4rpx 16rpx rgba(160, 134, 121, 0.1);
  position: relative;
  overflow: hidden;
}

.basic-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(to right, #a08679, #e6c9b7, transparent);
}

.tag-basic {
  color: #ffffff !important;
  background-color: rgba(106, 168, 79, 0.9) !important;
}

/* 所有产品卡片共有的动画效果 */
.product-card {
  transition: all 0.3s ease;
}

.product-card:active {
  transform: scale(0.98);
}

/* 为导航文字添加阴影，增强对比度 */
.nav-center .nav-title,
.nav-back .back-icon {
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

/* 特别处理返回按钮，使其更易于辨识 */
.nav-back .back-icon {
  border-top: 3rpx solid rgba(51, 51, 51, 0.85); /* 加深颜色并增加透明度 */
  border-left: 3rpx solid rgba(51, 51, 51, 0.85);
}

/* 添加新的颜色变量 - 基于视频色调 */
page {
  --primary-color: #a08679; /* 温暖的木质棕色 */
  --primary-light: #d2c0b2; /* 浅暖棕色 */
  --primary-dark: #785a4d; /* 深暖棕色 */
  --accent-color: #c98c60; /* 温暖的橙棕色调 */
  --accent-light: #e6c9b7; /* 浅米色 */
  --text-primary: #4a3c32; /* 深木色文本 */
  --text-secondary: #7d685a; /* 中等棕色文本 */
  --background-color: #f9f7f5; /* 米白色背景 */
  --card-color: #ffffff; /* 白色卡片背景 */
} 