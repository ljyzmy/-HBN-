/* pages/favorites/favorites.wxss */

page {
  background-color: #f8f8f8;
  height: 100%;
}

.favorites-container {
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

/* 顶部操作栏样式 */
.action-bar {
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #eeeeee;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.right-actions {
  display: flex;
  align-items: center;
}

.edit-btn {
  font-size: 28rpx;
  color: #618a49;
  padding: 10rpx 20rpx;
  font-weight: 500;
}

/* 画像分析按钮样式 */
.portrait-btn {
  background-color: rgba(97, 138, 73, 0.1);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.portrait-text {
  font-size: 24rpx;
  color: #618a49;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(97, 138, 73, 0.2);
  border-top: 4rpx solid #618a49;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 收藏列表样式 */
.favorites-list {
  padding: 20rpx;
}

.favorite-item {
  display: flex;
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.item-hover {
  transform: scale(0.98);
  background-color: rgba(97, 138, 73, 0.05);
}

/* 选择框样式 */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  margin-right: 20rpx;
  margin-top: 60rpx;
  position: relative;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #618a49;
  border-color: #618a49;
  position: relative;
}

.checkbox.checked::after {
  content: "";
  position: absolute;
  width: 20rpx;
  height: 10rpx;
  border-left: 4rpx solid white;
  border-bottom: 4rpx solid white;
  top: 10rpx;
  left: 10rpx;
  transform: rotate(-45deg);
}

/* 商品图片样式 */
.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

/* 商品信息样式 */
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-category {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx;
  background-color: rgba(97, 138, 73, 0.08);
  border-radius: 20rpx;
  display: inline-block;
}

/* 用户画像标签样式 */
.portrait-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.portrait-tag {
  font-size: 20rpx;
  color: #618a49;
  background-color: rgba(97, 138, 73, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-container {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 32rpx;
  color: #618a49;
  font-weight: 500;
  margin-right: 10rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.add-cart-btn {
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 8rpx rgba(97, 138, 73, 0.2);
  transition: all 0.3s;
}

.add-cart-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 4rpx rgba(97, 138, 73, 0.2);
}

/* 改进的删除按钮样式 */
.delete-btn {
  color: #ff4d4f;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 30rpx;
  text-align: center;
  transition: all 0.3s;
}

.delete-btn:active {
  background-color: rgba(255, 77, 79, 0.1);
  transform: scale(0.95);
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(97, 138, 73, 0.2);
  transition: all 0.3s;
}

.go-shopping-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.2);
}

/* 底部操作栏样式 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.select-all {
  display: flex;
  align-items: center;
}

.select-all text {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}

/* 批量删除按钮样式优化 */
.batch-delete {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.2);
  transition: all 0.3s;
}

.batch-delete:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(255, 77, 79, 0.2);
}

.batch-delete.disabled {
  background: linear-gradient(135deg, #cccccc, #dddddd);
  color: #999;
  box-shadow: none;
}

/* 数据来源提示 */
.data-source-tip {
  text-align: center;
  padding: 20rpx 0;
  font-size: 22rpx;
  color: #999;
  margin-top: auto;
  margin-bottom: 120rpx; /* 确保在底部操作栏之上有足够的空间 */
}

/* 悬浮购物车按钮 */
.cart-btn {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #618a49, #8aad75);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(97, 138, 73, 0.3);
  z-index: 100;
  transition: all 0.3s;
}

.cart-btn:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.2);
}

.cart-icon {
  width: 56rpx;
  height: 56rpx;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
} 