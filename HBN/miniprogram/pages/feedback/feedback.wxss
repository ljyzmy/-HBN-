/* pages/feedback/feedback.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 20rpx;
}

/* 标题栏 */
.header {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.tab {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  position: relative;
  color: #666;
}

.tab.active {
  color: #618a49;
  font-weight: 500;
}

.tab.active:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #618a49;
  border-radius: 2rpx;
}

.tab.disabled {
  color: #ccc;
  pointer-events: none;
}

.badge {
  background-color: #ff6b6b;
  color: #fff;
  font-size: 22rpx;
  height: 32rpx;
  min-width: 32rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

/* 通用section样式 */
.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: #618a49;
  border-radius: 3rpx;
}

.required {
  color: #ff6b6b;
  margin-left: 4rpx;
}

/* 问题类型 */
.problem-types {
  display: flex;
  flex-wrap: wrap;
}

.type-item {
  padding: 16rpx 24rpx;
  background-color: #f7f7f7;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}

.type-item.active {
  background-color: rgba(97, 138, 73, 0.1);
  color: #618a49;
  font-weight: 500;
}

/* 问题描述 */
.textarea-box {
  position: relative;
  border: 1rpx solid #eaeaea;
  border-radius: 8rpx;
  padding: 20rpx;
}

.content-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
}

.placeholder-style {
  font-size: 28rpx;
  color: #999;
}

.word-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* 图片上传 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.delete-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #f9f9f9;
  transition: all 0.3s;
}

.upload-btn:active {
  background-color: #f0f0f0;
}

.upload-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.upload-btn text {
  font-size: 24rpx;
  color: #999;
}

.upload-tips {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 联系方式 */
.contact-input {
  height: 90rpx;
  border: 1rpx solid #eaeaea;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

/* 提交按钮 */
.submit-section {
  margin: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn {
  width: 90%;
  height: 90rpx;
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 15rpx rgba(97, 138, 73, 0.2);
  transition: all 0.3s;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.2);
}

.submit-btn.disabled {
  background: #cccccc;
  box-shadow: none;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 历史反馈列表 */
.history-list {
  min-height: 50vh;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.back-btn {
  margin-top: 40rpx;
  padding: 16rpx 40rpx;
  background-color: rgba(97, 138, 73, 0.1);
  color: #618a49;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.feedback-items {
  padding: 10rpx 0;
}

.feedback-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.feedback-type {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.feedback-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  color: #ff9800;
  background-color: rgba(255, 152, 0, 0.1);
}

.status-processing {
  color: #2196f3;
  background-color: rgba(33, 150, 243, 0.1);
}

.status-completed {
  color: #4caf50;
  background-color: rgba(76, 175, 80, 0.1);
}

.feedback-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feedback-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.feedback-time {
  flex: 1;
}

.has-image {
  display: flex;
  align-items: center;
}

.image-count {
  color: #618a49;
} 