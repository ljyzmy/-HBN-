/* pages/chatBot/chatBot.wxss */
page {
  --primary-color: #a08679; /* 温暖的木质棕色 */
  --primary-light: #d2c0b2; /* 浅暖棕色 */
  --primary-dark: #785a4d; /* 深暖棕色 */
  --accent-color: #c98c60; /* 温暖的橙棕色调 */
  --accent-light: #e6c9b7; /* 浅米色 */
  --text-primary: #4a3c32; /* 深木色文本 */
  --text-secondary: #7d685a; /* 中等棕色文本 */
  --background-color: #f9f7f5; /* 米白色背景 */
  --card-color: #ffffff; /* 白色卡片背景 */
  background-color: var(--background-color);
}

/* 主容器样式 */
.agent-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(to bottom, rgba(210, 192, 178, 0.1), rgba(249, 247, 245, 0.5));
}

/* 美化agent-ui组件 */
agent-ui {
  width: 100%;
  height: 100%;
  display: block;
  --chat-bot-bg-color: transparent;
  --chat-bot-bubble-color: rgba(255, 255, 255, 0.95);
  --chat-bot-input-bg-color: rgba(255, 255, 255, 0.8);
  --chat-bot-input-text-color: #4a3c32;
  --chat-bot-border-radius: 12px;
  --chat-bot-shadow: 0 4rpx 12rpx rgba(120, 90, 77, 0.1);
  --chat-bot-user-bubble-color: var(--primary-color);
  --chat-bot-user-text-color: #ffffff;
}

/* 自定义组件内部样式覆盖 */
.agent-ui .nav {
  background: linear-gradient(to bottom, #ffffff, rgba(255, 255, 255, 0.95));
  border-bottom: 1rpx solid rgba(160, 134, 121, 0.1);
  box-shadow: 0 4rpx 20rpx rgba(120, 90, 77, 0.08) !important;
}

.agent-ui .nav .nav-content {
  gap: 16rpx !important;
}

.agent-ui .nav .bot-name {
  color: var(--text-primary) !important;
  font-weight: 500 !important;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", sans-serif !important;
}

.agent-ui .bot-avatar {
  border: 2rpx solid var(--primary-light) !important;
  box-shadow: 0 4rpx 8rpx rgba(120, 90, 77, 0.15) !important;
}

.agent-ui .question_content {
  background-color: rgba(242, 237, 233, 0.5) !important;
  color: var(--text-secondary) !important;
  border: 1rpx solid rgba(160, 134, 121, 0.1);
  transition: all 0.3s ease;
}

.agent-ui .question_content:active {
  background-color: rgba(201, 140, 96, 0.1) !important;
}

.agent-ui .input_box {
  background-color: var(--background-color) !important;
  border-top: 1rpx solid rgba(160, 134, 121, 0.1) !important;
  padding: 10rpx 16rpx !important;
  box-shadow: 0 -4rpx 16rpx rgba(120, 90, 77, 0.03) !important;
}

.agent-ui .input {
  background-color: #ffffff !important;
  border-radius: 36rpx !important;
  border: 1rpx solid rgba(210, 192, 178, 0.3) !important;
  box-shadow: 0 2rpx 8rpx rgba(120, 90, 77, 0.05) !important;
  padding: 16rpx 24rpx !important;
}

.agent-ui .send-icon {
  background: linear-gradient(to right, var(--primary-color), var(--accent-color)) !important;
  box-shadow: 0 4rpx 8rpx rgba(201, 140, 96, 0.2) !important;
}

/* 美化消息气泡 */
.agent-ui .bubble.left {
  background-color: #ffffff !important;
  border-radius: 16rpx !important;
  border-top-left-radius: 4rpx !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05) !important;
}

.agent-ui .bubble.right {
  background: linear-gradient(135deg, var(--primary-color), var(--accent-color)) !important;
  border-radius: 16rpx !important;
  border-top-right-radius: 4rpx !important;
  box-shadow: 0 2rpx 8rpx rgba(160, 134, 121, 0.2) !important;
}

/* 添加页面背景装饰 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}

.page-bg::before {
  content: '';
  position: absolute;
  top: 10%;
  right: -10%;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 140, 96, 0.1) 0%, rgba(249, 247, 245, 0) 70%);
}

.page-bg::after {
  content: '';
  position: absolute;
  bottom: 15%;
  left: -5%;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(160, 134, 121, 0.1) 0%, rgba(249, 247, 245, 0) 70%);
}

/* 自定义进入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

agent-ui {
  animation: fadeIn 0.5s ease-out forwards;
}

/* 优化消息滚动体验 */
.agent-ui .chat-list {
  scroll-behavior: smooth !important;
  padding: 20rpx 24rpx !important;
}

/* 优化底部工具条 */
.agent-ui .foot_function {
  padding: 4rpx 0;
  display: flex;
  justify-content: center;
}

/* 优化设置面板 */
.agent-ui .set_panel {
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
  background-color: var(--background-color) !important;
}

.agent-ui .set_panel_cancel {
  color: var(--text-primary) !important;
  font-weight: normal;
  background-color: #ffffff;
}