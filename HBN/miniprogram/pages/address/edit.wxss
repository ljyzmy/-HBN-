/* pages/address/edit.wxss */
page {
  background-color: #f7f7f7;
}

.container {
  min-height: 100vh;
  background-color: #f7f7f7;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  border-bottom: 1rpx solid #f5f5f5;
  z-index: 100;
}

.nav-left {
  padding: 0 30rpx;
  height: 44px;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  color: #333;
  font-size: 16px;
  font-weight: 500;
}

.nav-placeholder {
  width: 100rpx;
  height: 44px;
}

/* 页面内容区域 */
.content-area {
  width: 100%;
  padding: 20rpx 0;
}

/* 加载中 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #618a49;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 表单样式 */
.form-wrapper {
  margin: 20rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  min-width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  flex: 1;
  width: 100%;
  font-size: 28rpx;
  line-height: 1.4;
  color: #333;
}

.region-picker {
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #999;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.form-item-textarea {
  align-items: flex-start;
}

.form-item-switch {
  justify-content: space-between;
}

/* 标签样式 */
.form-item-tags {
  flex-direction: column;
  align-items: flex-start;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  width: 100%;
}

.tag-item {
  height: 60rpx;
  padding: 0 30rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  background-color: #f7f7f7;
  border-radius: 30rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}

.tag-item.tag-selected {
  color: #fff;
  background-color: #618a49;
}

.tag-input {
  height: 60rpx;
  padding: 0 30rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f7f7f7;
  border-radius: 30rpx;
  margin-bottom: 20rpx;
  min-width: 180rpx;
}

/* 底部按钮 */
.bottom-btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #618a49, #8aad75);
  color: #fff;
  font-size: 30rpx;
  border-radius: 38rpx;
  box-shadow: 0 4rpx 12rpx rgba(97, 138, 73, 0.2);
  transition: all 0.3s;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.2);
}

/* 提交按钮加载状态 */
.save-btn.btn-disabled {
  opacity: 0.8;
  background: linear-gradient(135deg, #618a49, #8aad75);
  pointer-events: none;
}

.btn-loading {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
} 