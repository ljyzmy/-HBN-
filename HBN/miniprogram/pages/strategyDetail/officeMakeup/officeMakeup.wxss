/* 容器样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: var(--birch-white, #f9f9f7);
  position: relative;
  padding-bottom: 40rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.nav-transparent {
  background-color: transparent;
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(84, 109, 86, 0.1);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-top: 3rpx solid #333;
  border-left: 3rpx solid #333;
  transform: rotate(-45deg);
}

.nav-center {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.nav-placeholder {
  width: 60rpx;
}

/* 头部图片容器 */
.header-image-container {
  width: 100%;
  height: 500rpx;
  position: relative;
  overflow: hidden;
}

.header-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  display: flex;
  align-items: flex-end;
  padding: 40rpx;
}

.title-container {
  width: 100%;
}

.page-title {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.page-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.meta-divider {
  margin: 0 16rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 内容容器 */
.content-container {
  padding: 40rpx 30rpx;
  background-color: #fff;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 介绍部分 */
.intro-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: rgba(166, 64, 54, 0.05);
  border-radius: 16rpx;
  border-left: 6rpx solid rgba(166, 64, 54, 0.7);
}

.intro-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  text-align: justify;
}

/* 产品清单 */
.product-checklist-container {
  margin: 40rpx 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  position: relative;
  display: inline-block;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.section-title.elegant::after {
  content: "";
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 40rpx;
  height: 3rpx;
  background-color: var(--cedar-medium, #618a49);
}

.product-checklist {
  background-color: rgba(97, 138, 73, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  border-right: 6rpx solid rgba(97, 138, 73, 0.7);
}

.checklist-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 10rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
}

.checklist-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: var(--cedar-medium, #618a49);
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checklist-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 7rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: translate(-50%, -70%) rotate(-45deg);
}

.checklist-content {
  flex: 1;
}

.checklist-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.checklist-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 妆容步骤 */
.makeup-steps-container {
  margin: 40rpx 0;
}

.step-section {
  margin-bottom: 40rpx;
}

.step-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--dunhuang-brown, #8a634d);
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  background-color: rgba(166, 64, 54, 0.1);
  border-radius: 10rpx;
  display: inline-block;
}

.step-items {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.step-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  border-left: 4rpx solid rgba(166, 64, 54, 0.7);
}

.step-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: rgba(166, 64, 54, 0.05);
}

.step-number {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: var(--dunhuang-red, #a64036);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.step-video-container {
  width: 100%;
  height: 400rpx;
  position: relative;
  overflow: hidden;
}

.step-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.step-detail {
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 小贴士 */
.makeup-tips-container {
  margin: 40rpx 0;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-item {
  padding: 20rpx;
  background-color: rgba(97, 138, 73, 0.05);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border-right: 4rpx solid rgba(97, 138, 73, 0.7);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: var(--cedar-medium, #618a49);
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-icon::after {
  content: '!';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.tip-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 相关产品推荐 */
.related-products-container {
  margin: 40rpx 0;
  position: relative;
}

.related-products-container::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  background-image: url('https://img.api.aa1.cn/2025/05/07/a80093e62c237.jpg');
  background-size: contain;
  opacity: 0.05;
  z-index: -1;
}

.related-products-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.related-product-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.related-product-item:active {
  transform: scale(0.98);
}

/* 相关产品视频容器 */
.related-product-video-container {
  width: 100%;
  height: 200rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx 16rpx 0 0;
}

.related-product-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.related-product-info {
  padding: 16rpx;
}

.related-product-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.related-product-price-row {
  display: flex;
  align-items: baseline;
}

.related-product-price {
  font-size: 28rpx;
  color: var(--cedar-medium, #618a49);
  font-weight: bold;
  margin-right: 10rpx;
}

.related-product-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

/* 底部声明 */
.footer-disclaimer {
  margin-top: 60rpx;
  padding: 30rpx;
  border-top: 1rpx solid #eee;
  text-align: center;
}

.disclaimer-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.disclaimer-copyright {
  display: block;
  font-size: 22rpx;
  color: #aaa;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.step-item, .tip-item, .checklist-item {
  animation: fadeIn 0.6s ease-in-out;
}

/* 针对小屏设备优化产品列表 */
@media screen and (max-width: 375px) {
  .related-products-list {
    grid-template-columns: repeat(2, 1fr);
  }
} 