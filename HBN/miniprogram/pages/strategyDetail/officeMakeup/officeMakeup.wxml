<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav {{scrolled ? 'nav-opaque' : 'nav-transparent'}}">
    <view class="nav-back" bindtap="goBack">
      <view class="back-icon"></view>
    </view>
    <view class="nav-center">
      <text class="nav-title">{{pageTitle}}</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 头部图片 -->
  <view class="header-image-container">
    <image src="{{pageImage}}" mode="aspectFill" class="header-image"></image>
    <view class="image-overlay">
      <view class="title-container">
        <text class="page-title">{{pageTitle}}</text>
        <view class="page-meta">
          <text class="meta-item">{{readCount}}人已读</text>
          <text class="meta-divider">|</text>
          <text class="meta-item">{{publishDate}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-container">
    <!-- 介绍部分 -->
    <view class="intro-section">
      <text class="intro-text">{{introduction}}</text>
    </view>

    <!-- 产品清单 -->
    <view class="product-checklist-container">
      <view class="section-title elegant">十分钟妆容产品清单</view>
      <view class="product-checklist">
        <view class="checklist-item" wx:for="{{productList}}" wx:key="name">
          <view class="checklist-icon"></view>
          <view class="checklist-content">
            <text class="checklist-name">{{item.name}}</text>
            <text class="checklist-desc">{{item.desc}} - {{item.usage}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 妆容步骤 -->
    <view class="makeup-steps-container">
      <view class="section-title elegant">妆容步骤 (时间: 10分钟)</view>
      
      <view class="step-section" wx:for="{{makeupSteps}}" wx:key="title" wx:for-index="sectionIndex">
        <view class="step-section-title">{{item.title}}</view>
        
        <view class="step-items">
          <view class="step-item" wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="name">
            <view class="step-header">
              <view class="step-number">{{sectionIndex+1}}.{{stepIndex+1}}</view>
              <text class="step-name">{{step.name}}</text>
            </view>
            
            <!-- 步骤视频 -->
            <view class="step-video-container">
              <video 
                id="step-video-{{sectionIndex}}-{{stepIndex}}"
                src="{{step.videoUrl}}" 
                class="step-video"
                poster="{{step.imageUrl}}"
                object-fit="cover"
                autoplay="{{true}}"
                loop="{{true}}"
                muted="{{true}}"
                show-center-play-btn="{{false}}"
                controls="{{false}}"
                show-progress="{{false}}"
                enable-progress-gesture="{{false}}"
                binderror="videoError">
              </video>
            </view>
            
            <view class="step-detail">
              <text>{{step.detail}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 职场妆容小贴士 -->
    <view class="makeup-tips-container">
      <view class="section-title elegant">职场妆容小贴士</view>
      <view class="tips-list">
        <view class="tip-item" wx:for="{{makeupTips}}" wx:key="title">
          <view class="tip-header">
            <view class="tip-icon"></view>
            <text class="tip-title">{{item.title}}</text>
          </view>
          <text class="tip-content">{{item.content}}</text>
        </view>
      </view>
    </view>

    <!-- 相关产品推荐 -->
    <view class="related-products-container">
      <view class="section-title elegant">相关产品推荐</view>
      <view class="related-products-list">
        <view class="related-product-item" wx:for="{{relatedProducts}}" wx:key="id" bindtap="goToProduct" data-id="{{item.id}}">
          <!-- 视频展示 -->
          <view class="related-product-video-container">
            <video 
              id="related-product-video-{{index}}"
              src="{{item.videoUrl}}" 
              class="related-product-video"
              poster="{{item.imageUrl}}"
              object-fit="cover"
              autoplay="{{true}}"
              loop="{{true}}"
              muted="{{true}}"
              show-center-play-btn="{{false}}"
              controls="{{false}}"
              show-progress="{{false}}"
              enable-progress-gesture="{{false}}"
              binderror="videoError">
            </video>
          </view>
          <view class="related-product-info">
            <text class="related-product-name">{{item.name}}</text>
            <view class="related-product-price-row">
              <text class="related-product-price">{{item.price}}</text>
              <text class="related-product-original">{{item.originalPrice}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部声明 -->
    <view class="footer-disclaimer">
      <text class="disclaimer-text">本教程仅供参考，可根据个人肤质和职场环境适当调整。</text>
      <text class="disclaimer-copyright">© 2025 HBN美妆 版权所有</text>
    </view>
  </view>
</view> 