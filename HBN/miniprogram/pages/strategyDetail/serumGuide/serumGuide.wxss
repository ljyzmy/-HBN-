/* pages/strategyDetail/serumGuide/serumGuide.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f9f7f5;
  position: relative;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.nav-transparent {
  background-color: transparent;
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 130rpx;
  width: 240rpx;
}

.nav-placeholder {
  width: 80rpx;
}

/* 页面内容区域 */
.page-content {
  height: 100vh;
  position: relative;
  z-index: 1;
}

/* 头部图片容器 */
.header-image-container {
  position: relative;
  height: 500rpx;
  width: 100%;
}

.header-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.header-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.read-count {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
}

.read-count::before {
  content: "";
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ffffff"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>');
  background-size: contain;
  background-repeat: no-repeat;
  margin-right: 6rpx;
}

/* 导言部分 */
.intro-section {
  padding: 40rpx 30rpx;
  margin: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.intro-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 60rpx;
  background-color: #a08679;
  border-radius: 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3c32;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.intro-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

/* 精华乳类型部分 */
.serum-types-section {
  padding: 40rpx 30rpx;
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.serum-types-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 60rpx;
  background-color: #c98c60;
  border-radius: 4rpx;
}

.serum-type-item {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.serum-type-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.serum-type-header {
  margin-bottom: 20rpx;
}

.serum-type-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4a3c32;
  margin-bottom: 8rpx;
}

.serum-suitable {
  font-size: 24rpx;
  color: #a08679;
  background-color: rgba(160, 134, 121, 0.1);
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.serum-media-container {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background-color: #f6f6f6;
}

.serum-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.serum-ingredients {
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
}

.ingredients-label {
  font-size: 26rpx;
  color: #4a3c32;
  font-weight: bold;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.ingredients-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.serum-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.serum-recommend {
  background-color: rgba(160, 134, 121, 0.05);
  padding: 20rpx;
  border-radius: 12rpx;
}

.recommend-title {
  font-size: 26rpx;
  color: #4a3c32;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.recommend-products {
  display: flex;
  flex-direction: column;
}

.recommend-product-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.recommend-product-item:last-child {
  border-bottom: none;
}

.product-name {
  font-size: 26rpx;
  color: #666;
}

.arrow-right {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #a08679;
  border-right: 2rpx solid #a08679;
  transform: rotate(45deg);
}

/* 选择要点部分 */
.tips-section {
  padding: 40rpx 30rpx;
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.tips-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 60rpx;
  background-color: #618a49;
  border-radius: 4rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
}

.tip-number {
  width: 40rpx;
  height: 40rpx;
  background-color: #618a49;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.tip-text {
  flex: 1;
}

.tip-title {
  font-size: 28rpx;
  color: #4a3c32;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 相关产品推荐 */
.related-products-section {
  padding: 40rpx 30rpx;
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.related-products-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 60rpx;
  background-color: #d2c0b2;
  border-radius: 4rpx;
}

/* 横向滚动视图容器 */
.related-products-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 20rpx;
}

.related-products-container {
  display: flex;
  padding: 10rpx 0;
}

.related-product {
  width: 280rpx; 
  background-color: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  margin-right: 20rpx;
  display: inline-block;
  flex-shrink: 0;
}

.related-product:active {
  transform: scale(0.98);
}

.related-product:last-child {
  margin-right: 10rpx;
}

.related-product-image {
  width: 100%;
  height: 280rpx;
  object-fit: cover;
}

.related-product-info {
  padding: 16rpx;
}

.related-product-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  height: 72rpx;
  line-height: 1.4;
}

.related-product-price {
  font-size: 28rpx;
  color: #a08679;
  font-weight: bold;
}

/* 底部安全区域 */
.safe-bottom-area {
  height: 100rpx;
}