/* 容器样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: var(--birch-white, #f9f9f7);
  position: relative;
  padding-bottom: 40rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.nav-transparent {
  background-color: transparent;
}

.nav-opaque {
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(84, 109, 86, 0.1);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-top: 3rpx solid #333;
  border-left: 3rpx solid #333;
  transform: rotate(-45deg);
}

.nav-center {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.nav-placeholder {
  width: 60rpx;
}

/* 头部图片容器 */
.header-image-container {
  width: 100%;
  height: 500rpx;
  position: relative;
  overflow: hidden;
}

.header-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  display: flex;
  align-items: flex-end;
  padding: 40rpx;
}

.title-container {
  width: 100%;
}

.page-title {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.page-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.meta-divider {
  margin: 0 16rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 内容容器 */
.content-container {
  padding: 40rpx 30rpx;
  background-color: #fff;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 介绍部分 */
.intro-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: rgba(166, 64, 54, 0.05);
  border-radius: 16rpx;
  border-left: 6rpx solid rgba(166, 64, 54, 0.7);
}

.intro-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  text-align: justify;
}

/* 肤质类型卡片 */
.skin-types-container {
  margin: 40rpx 0;
}

.skin-type-card {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background-color: #f8f9f7;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.skin-type-card:nth-child(even) {
  background-color: rgba(97, 138, 73, 0.05);
  border-right: 6rpx solid rgba(97, 138, 73, 0.7);
}

.skin-type-card:nth-child(odd) {
  background-color: rgba(166, 64, 54, 0.05);
  border-left: 6rpx solid rgba(166, 64, 54, 0.7);
}

.skin-type-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.skin-type-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.icon-left {
  background-color: rgba(166, 64, 54, 0.9);
}

.icon-right {
  background-color: rgba(97, 138, 73, 0.9);
}

.skin-type-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.skin-type-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
}

/* 护理要点 */
.tips-container {
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--cedar-medium, #618a49);
  margin-top: 12rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  flex: 1;
}

/* 推荐产品 */
.recommend-products {
  margin-top: 30rpx;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  position: relative;
}

.recommend-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 40rpx;
  height: 3rpx;
  background-color: var(--cedar-medium, #618a49);
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  object-fit: cover;
}

.product-info {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 26rpx;
  color: var(--dunhuang-red, #a64036);
  font-weight: bold;
  margin-bottom: 10rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

/* 底妆技巧部分 */
.makeup-tips-container {
  margin: 40rpx 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  position: relative;
  display: inline-block;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.section-title.elegant::after {
  content: "";
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 40rpx;
  height: 3rpx;
  background-color: var(--cedar-medium, #618a49);
}

.makeup-tips-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.tip-card {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.tip-image {
  width: 220rpx;
  height: auto;
  object-fit: cover;
}

.tip-content {
  flex: 1;
  padding: 20rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.tip-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 相关产品推荐 */
.related-products-container {
  margin: 40rpx 0;
}

.related-products-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.related-product-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.related-product-item:active {
  transform: scale(0.98);
}

.related-product-image {
  width: 100%;
  height: 200rpx;
  object-fit: cover;
}

.related-product-info {
  padding: 16rpx;
}

.related-product-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.related-product-price-row {
  display: flex;
  align-items: baseline;
}

.related-product-price {
  font-size: 26rpx;
  color: var(--dunhuang-red, #a64036);
  font-weight: bold;
  margin-right: 10rpx;
}

.related-product-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

/* 底部声明 */
.footer-disclaimer {
  margin-top: 60rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
  text-align: center;
}

.disclaimer-text,
.disclaimer-copyright {
  font-size: 24rpx;
  color: #999;
  display: block;
  line-height: 1.5;
}

.disclaimer-copyright {
  margin-top: 10rpx;
}

/* 添加动画效果 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.skin-type-card,
.tip-card,
.related-product-item {
  animation: fadeIn 0.5s ease forwards;
}

.skin-type-card:nth-child(1) { animation-delay: 0.1s; }
.skin-type-card:nth-child(2) { animation-delay: 0.2s; }
.skin-type-card:nth-child(3) { animation-delay: 0.3s; }
.skin-type-card:nth-child(4) { animation-delay: 0.4s; }

.tip-card:nth-child(1) { animation-delay: 0.3s; }
.tip-card:nth-child(2) { animation-delay: 0.4s; }
.tip-card:nth-child(3) { animation-delay: 0.5s; }

/* 添加渐变背景装饰 */
.skin-type-card:nth-child(even)::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(97, 138, 73, 0.1) 0%, rgba(97, 138, 73, 0) 70%);
  border-radius: 50%;
  z-index: 0;
}

.skin-type-card:nth-child(odd)::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(166, 64, 54, 0.1) 0%, rgba(166, 64, 54, 0) 70%);
  border-radius: 50%;
  z-index: 0;
}

/* 敦煌风格装饰 */
.related-products-container::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  background-image: url('https://img.api.aa1.cn/2025/05/07/a80093e62c237.jpg');
  background-size: contain;
  opacity: 0.05;
  z-index: -1;
}

/* 产品视频容器样式 */
.product-video-container {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
}

.product-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8rpx;
}

/* 相关产品视频容器样式 */
.related-product-video-container {
  width: 100%;
  height: 200rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx 16rpx 0 0;
}

.related-product-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 16rpx 16rpx 0 0;
}

/* 修改产品项目布局，适应视频元素 */
.product-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 视频加载时的过渡效果 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.product-video,
.related-product-video {
  animation: fadeIn 0.5s ease-in-out;
} 