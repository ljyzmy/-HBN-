/* pages/cart/cart.wxss */
/* 重置容器样式，防止与app.wxss冲突 */
.page-container {
  height: 150vh;
  padding: 0;
  display: block;
  justify-content: initial;
  align-items: initial;
}

/* 容器样式 */
.container {
  padding: 0;
  background-color: #f8f8f8;
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 添加滚动视图样式 */
.vertical-scroll {
  height: calc(100vh - 120rpx); /* 减去底部结算栏高度 */
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 120rpx;
}

/* 内容容器添加顶部间距 */
.content-container {
  padding-top: 180rpx; /* 与导航栏高度一致 */
  padding-bottom: 40rpx;
  box-sizing: border-box;
  min-height: calc(100vh - 120rpx);
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx 20rpx 30rpx;
  z-index: 1000;
  box-sizing: border-box;
  transition: background-color 0.3s ease-in-out;
}

.nav-transparent {
  background-color: rgba(255, 255, 255, 0);
}

.nav-opaque {
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.search-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-logo {
  height: 130rpx;
  width: 240rpx;
}

.nav-placeholder {
  width: 80rpx;
}
/* 容器样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  position: relative;
  padding-bottom: 170rpx;
}

/* 顶部标题栏 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.header-actions {
  display: flex;
  align-items: center;
}

.delete-all-btn {
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
  transition: all 0.3s ease;
}

.delete-all-btn:active {
  background-color: rgba(255, 77, 79, 0.1);
}

.header-edit {
  font-size: 28rpx;
  color: #618a49;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.header-edit:active {
  background-color: rgba(97, 138, 73, 0.1);
}

/* 空购物车状态 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  position: relative;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.empty-tips {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.continue-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(to right, var(--cedar-medium), var(--cedar-light));
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(97, 138, 73, 0.3);
  transition: all 0.3s ease;
}

.continue-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(97, 138, 73, 0.2);
}

/* 购物车内容区 */
.cart-content {
  padding: 20rpx 0;
}

/* 购物车列表 */
.cart-list {
  margin-bottom: 40rpx;
}

.cart-item {
  position: relative;
  background-color: var(--dunhuang-light);
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  border-left: 6rpx solid var(--dunhuang-red);
}

.cart-item:active {
  background-color: #f9f9f9;
}

.item-content {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  position: relative;
}

/* 选择按钮 */
.select-btn {
  margin-right: 20rpx;
  margin-left: 0;
}

.select-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-circle.selected {
  border-color: var(--dunhuang-red);
}

.select-inner {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: var(--dunhuang-red);
}

/* 删除按钮样式 */
.delete-btn-item {
  position: absolute;
  left: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background-color: #ff4d4f;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
  z-index: 10;
  animation: slideIn 0.3s ease-out;
  transition: all 0.3s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    left: -30rpx;
  }
  to {
    opacity: 1;
    left: 10rpx;
  }
}

.delete-btn-item:active {
  transform: translateY(-50%) scale(0.9);
  background-color: #ff7875;
}

.delete-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 商品图片 */
.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background-color: #f6f6f6;
  margin-right: 20rpx;
}

/* 商品信息 */
.item-info {
  flex: 1;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  max-height: 84rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.item-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-container {
  display: flex;
  align-items: baseline;
}

.item-price {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--dunhuang-red);
  margin-right: 10rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
}

.item-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

/* 数量控制 */
.count-control {
  display: flex;
  align-items: center;
  height: 52rpx;
  border-radius: 26rpx;
  overflow: hidden;
  border: 1px solid #e0e0e0;
}

.count-btn {
  width: 60rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: #f5f5f5;
}

.count-btn.disabled {
  color: #ccc;
}

.count-number {
  width: 60rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

/* 底部结算栏 */
.cart-footer {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.footer-left {
  display: flex;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
}

.select-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}

.footer-right {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.total-container {
  margin-right: 10rpx;
  white-space: nowrap;
}

.total-label {
  font-size: 24rpx;
  color: #333;
}

.total-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #618a49;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.checkout-btn {
  width: 160rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background-color: #A64036;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 38rpx;
  box-shadow: 0 4rpx 12rpx rgba(166, 64, 54, 0.3);
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  margin-right: 10rpx;
}

.pay-now-btn {
  width: 160rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background-color: #618a49;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 38rpx;
  box-shadow: 0 4rpx 12rpx rgba(97, 138, 73, 0.3);
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.delete-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(to right, #ff4d4f, #ff7875);
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 77, 79, 0.3);
  transition: all 0.3s ease;
}

.delete-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
}

/* 底部安全区域 */
.safe-bottom-area {
  height: 120rpx; /* 与底部结算栏高度一致 */
}

/* 推荐商品区域 */
.recommend-section {
  padding: 40rpx 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 20rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.recommend-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('https://img.api.aa1.cn/2025/05/07/a80093e62c237.jpg');
  background-size: cover;
  background-repeat: no-repeat;
  opacity: 0.03;
  z-index: 0;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 1;
  font-family: "FZLiBian", "FZLTXH--GBK1-0", sans-serif;
  color: var(--dunhuang-brown);
}

.title-line {
  width: 60rpx;
  height: 1px;
  background-color: var(--dunhuang-orange);
  opacity: 0.5;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--cedar-dark);
  margin: 0 20rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.recommend-item {
  position: relative;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding-bottom: 20rpx;
}

.recommend-image {
  width: 100%;
  height: 320rpx;
  background-color: #f6f6f6;
  margin-bottom: 16rpx;
}

.recommend-name {
  font-size: 28rpx;
  color: #333;
  margin: 0 20rpx 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  height: 80rpx;
  white-space: normal;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
}

.recommend-price-row {
  display: flex;
  align-items: baseline;
  margin: 0 20rpx;
}

.recommend-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--cedar-medium);
  margin-right: 10rpx;
  font-family: "FZLTXH--GBK1-0", "方正兰亭黑", "PingFang SC", "Microsoft YaHei", "Heiti SC", sans-serif;
  font-weight: 500;
}

.recommend-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.add-to-cart-btn {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--cedar-medium);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 44rpx;
  text-align: center;
  box-shadow: 0 4rpx 8rpx rgba(97, 138, 73, 0.3);
}

/* 移除不需要的横向滚动样式 */
.recommend-list {
  display: none;
}

.recommend-content {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding-bottom: 40rpx; /* 为底部的加号按钮留出空间 */
}

.recommend-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: rgba(97, 138, 73, 0.85);
  color: #ffffff;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  z-index: 5;
}